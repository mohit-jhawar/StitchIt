---
import Layout from '../layouts/Layout.astro';

const user = Astro.locals.user;
---

<Layout title="StitchIt - Premium Tailoring Management">
  <div class="min-h-screen bg-gradient-to-br from-slate-900 via-indigo-950 to-purple-950">
    <!-- Navigation -->
    <nav class="flex items-center justify-between px-6 py-5 max-w-7xl mx-auto">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-500 rounded-xl flex items-center justify-center text-white text-xl font-bold shadow-lg">
          S
        </div>
        <span class="text-2xl font-bold text-white tracking-tight">StitchIt</span>
      </div>
      <div class="flex items-center gap-4">
        {user ? (
          <a href="/dashboard" class="px-5 py-2.5 bg-indigo-600 text-white rounded-xl font-medium hover:bg-indigo-500 transition-colors">
            Dashboard
          </a>
        ) : (
          <>
            <a href="/login" class="text-slate-300 hover:text-white font-medium transition-colors">Sign in</a>
            <a href="/register" class="px-5 py-2.5 bg-indigo-600 text-white rounded-xl font-medium hover:bg-indigo-500 transition-colors">
              Get Started
            </a>
          </>
        )}
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-6 pt-16 pb-24 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-500/20 border border-indigo-500/30 rounded-full text-indigo-300 text-sm font-medium mb-8">
        <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
        Trusted by 500+ tailoring shops
      </div>

      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold text-white leading-tight mb-6">
        Tailoring Business
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-400"> Simplified</span>
      </h1>

      <p class="text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
        Complete management solution for tailors — orders, measurements, appointments, payments, and analytics in one beautiful platform.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/register"
          class="w-full sm:w-auto px-8 py-4 bg-indigo-600 text-white rounded-xl font-semibold text-lg hover:bg-indigo-500 transition-all shadow-xl shadow-indigo-500/30 hover:scale-105"
        >
          Start Free Today
        </a>
        <a
          href="/login"
          class="w-full sm:w-auto px-8 py-4 bg-white/10 text-white rounded-xl font-semibold text-lg hover:bg-white/20 transition-all border border-white/20"
        >
          Sign In
        </a>
      </div>


    </section>

    <!-- Features Section -->
    <section class="max-w-7xl mx-auto px-6 pb-24">
      <h2 class="text-3xl font-bold text-white text-center mb-4">Everything You Need</h2>
      <p class="text-slate-400 text-center mb-12 max-w-xl mx-auto">Powerful features designed specifically for tailoring businesses of all sizes.</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { icon: '📦', title: 'Order Management', desc: 'Track every order from creation to delivery with real-time status updates and timeline.' },
          { icon: '📏', title: 'Measurements', desc: 'Store detailed customer measurements for perfect fits every time.' },
          { icon: '📅', title: 'Appointments', desc: 'Schedule and manage fitting appointments seamlessly.' },
          { icon: '💰', title: 'Payments & Revenue', desc: 'Track advance payments, balances, and generate revenue reports.' },
          { icon: '📊', title: 'Analytics', desc: 'Visual insights into your business performance with charts and reports.' },
          { icon: '🎟️', title: 'Coupons & Offers', desc: 'Create discount coupons to attract and retain customers.' },
          { icon: '👥', title: 'Multi-Role Access', desc: 'Separate dashboards for admins, tailors, and customers.' },
          { icon: '📱', title: 'Mobile Friendly', desc: 'Works beautifully on desktop, tablet, and mobile devices.' },
          { icon: '🔔', title: 'Notifications', desc: 'Real-time notifications to keep everyone in the loop.' },
        ].map((f) => (
          <div class="p-6 bg-white/5 border border-white/10 rounded-2xl hover:bg-white/10 transition-all group">
            <div class="text-3xl mb-4">{f.icon}</div>
            <h3 class="text-lg font-semibold text-white mb-2">{f.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="max-w-3xl mx-auto px-6 pb-24 text-center">
      <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-3xl p-12 shadow-2xl">
        <h2 class="text-3xl font-bold text-white mb-4">Ready to Transform Your Business?</h2>
        <p class="text-indigo-200 mb-8">Join thousands of tailors who trust StitchIt to run their business.</p>
        <a
          href="/register"
          class="inline-flex items-center gap-2 px-8 py-4 bg-white text-indigo-700 rounded-xl font-bold text-lg hover:bg-indigo-50 transition-all shadow-xl"
        >
          Get Started Free →
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-white/10 py-8 text-center text-slate-500 text-sm">
      <p>&copy; 2026 StitchIt. Built with Astro, React & TailwindCSS.</p>
    </footer>
  </div>
</Layout>
