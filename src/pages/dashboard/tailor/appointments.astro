---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import AppointmentList from '../../../components/appointments/AppointmentList';
import db from '../../../lib/db';

const user = Astro.locals.user;
if (!user || user.role !== 'TAILOR') return Astro.redirect('/dashboard');

const tailorProfile = await db.tailorProfile.findUnique({ where: { userId: user.id }, select: { id: true } });
const myTailorId = tailorProfile?.id ?? '';
---

<DashboardLayout title="My Appointments - StitchIt" pageTitle="Appointments">
  <div class="space-y-6 pt-2">
    <AppointmentList role="TAILOR" myTailorId={myTailorId} client:load />
  </div>
</DashboardLayout>
