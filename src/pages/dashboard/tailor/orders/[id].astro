---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import OrderDetail from '../../../../components/orders/OrderDetail';

const user = Astro.locals.user;
if (!user || user.role !== 'TAILOR') return Astro.redirect('/dashboard');

const { id } = Astro.params;
if (!id) return Astro.redirect('/dashboard/tailor/orders');
---

<DashboardLayout title="Order Detail - StitchIt" pageTitle="Order Detail">
  <div class="space-y-6">
    <div class="flex items-center gap-3">
      <a
        href="/dashboard/tailor/orders"
        class="text-sm text-gray-500 hover:text-indigo-600 transition-colors flex items-center gap-1"
      >
        ← Back to My Work
      </a>
    </div>

    <OrderDetail orderId={id} role="TAILOR" client:load />
  </div>
</DashboardLayout>
