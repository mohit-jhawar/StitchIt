---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import db from '../../../lib/db';
import { formatCurrency, formatDate, getOrderStatusColor } from '../../../lib/utils';

const user = Astro.locals.user;
if (!user || user.role !== 'TAILOR') return Astro.redirect('/dashboard');

const profile = await db.tailorProfile.findUnique({ where: { userId: user.id } });
if (!profile) return Astro.redirect('/login');

const orders = await db.order.findMany({
  where: { tailorId: profile.id },
  orderBy: { createdAt: 'desc' },
  include: {
    customer: { select: { name: true, phone: true } },
    payments: { orderBy: { paidAt: 'desc' } },
    items: { include: { service: true } },
  },
});

// Per-order financial calculations
const orderFinancials = orders.map((o) => {
  const totalPaid = o.payments.reduce((s, p) => s + p.amount, 0);
  const balanceDue = Math.max(0, o.totalAmount - totalPaid);
  return { ...o, totalPaid, balanceDue };
});

// Summary totals
const totalBilled   = orders.reduce((s, o) => s + o.totalAmount, 0);
const totalCollected = orders.reduce((s, o) => s + o.payments.reduce((ps, p) => ps + p.amount, 0), 0);
const totalOutstanding = Math.max(0, totalBilled - totalCollected);
const ordersWithDue = orderFinancials.filter((o) => o.balanceDue > 0);
const deliveredOrders = orders.filter((o) => o.status === 'DELIVERED').length;
---

<DashboardLayout title="My Earnings - StitchIt" pageTitle="Earnings & Dues">
  <div class="space-y-4">
    <div>
      <h1 class="text-xl font-bold text-gray-900">Earnings & Dues</h1>
      <p class="text-gray-500 text-xs mt-1">Track what you've earned and what's still pending from customers.</p>
    </div>

    <!-- Summary cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { label: 'Total Earned', value: formatCurrency(profile.totalEarnings), icon: '💰', color: 'bg-green-50 text-green-600', border: 'border-green-200' },
        { label: 'Total Billed', value: formatCurrency(totalBilled), icon: '🧾', color: 'bg-indigo-50 text-indigo-600', border: 'border-indigo-200' },
        { label: 'Collected', value: formatCurrency(totalCollected), icon: '✅', color: 'bg-blue-50 text-blue-600', border: 'border-blue-200' },
        { label: 'Outstanding', value: formatCurrency(totalOutstanding), icon: '⏳', color: 'bg-red-50 text-red-600', border: 'border-red-200' },
      ].map((s) => (
        <div class={`bg-white rounded-xl border ${s.border} p-3.5`}>
          <div class={`w-8 h-8 ${s.color} rounded-lg flex items-center justify-center text-lg mb-2`}>{s.icon}</div>
          <p class="text-[10px] text-gray-500 uppercase tracking-tight">{s.label}</p>
          <p class="text-xl font-bold text-gray-900 mt-0.5">{s.value}</p>
        </div>
      ))}
    </div>

    <!-- Secondary stats -->
    <div class="grid grid-cols-3 gap-4">
      {[
        { label: 'Total Orders', value: orders.length },
        { label: 'Delivered', value: deliveredOrders },
        { label: 'Orders with Due', value: ordersWithDue.length },
      ].map((s) => (
        <div class="bg-white rounded-xl border border-gray-200 p-3 text-center">
          <p class="text-xl font-bold text-gray-900">{s.value}</p>
          <p class="text-[10px] text-gray-500 mt-0.5 uppercase tracking-tight">{s.label}</p>
        </div>
      ))}
    </div>

    <!-- Pending dues alert -->
    {ordersWithDue.length > 0 && (
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-xl">⚠️</span>
          <div>
            <h2 class="text-sm font-semibold text-amber-900">Payment Pending</h2>
            <p class="text-[10px] text-amber-700">{ordersWithDue.length} orders total {formatCurrency(totalOutstanding)} due</p>
          </div>
        </div>
        <div class="space-y-2">
          {ordersWithDue.map((o) => (
            <div class="bg-white rounded-lg border border-amber-200 px-3 py-2 flex items-center justify-between">
              <div>
                <p class="font-mono font-semibold text-indigo-600 text-[10px]">{o.orderNumber}</p>
                <p class="text-xs font-medium text-gray-900">{o.customer.name}</p>
              </div>
              <div class="text-right">
                <p class="text-xs font-bold text-red-600 font-mono">{formatCurrency(o.balanceDue)} due</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- All orders breakdown -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="px-4 py-2.5 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Financial Breakdown</h2>
      </div>

      {orderFinancials.length === 0 ? (
        <div class="p-10 text-center text-gray-400">
          <p class="text-4xl mb-2">🧵</p>
          <p>No orders assigned yet</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="text-left px-4 py-2 font-medium text-gray-500 text-xs">Order</th>
                <th class="text-left px-4 py-2 font-medium text-gray-500 text-xs">Customer</th>
                <th class="text-left px-4 py-2 font-medium text-gray-500 text-xs">Services</th>
                <th class="text-left px-4 py-2 font-medium text-gray-500 text-xs">Status</th>
                <th class="text-right px-4 py-2 font-medium text-gray-500 text-xs">Billed</th>
                <th class="text-right px-4 py-2 font-medium text-gray-500 text-xs text-right">Due</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {orderFinancials.map((o) => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-2">
                    <a href={`/dashboard/tailor/orders/${o.id}`} class="font-mono font-semibold text-indigo-600 hover:underline text-[10px]">
                      {o.orderNumber}
                    </a>
                  </td>
                  <td class="px-4 py-2">
                    <p class="font-medium text-gray-900 text-xs">{o.customer.name}</p>
                  </td>
                  <td class="px-4 py-2 text-gray-500 text-[10px] max-w-[140px] truncate">
                    {o.items.map((i) => i.service.name).join(', ')}
                  </td>
                  <td class="px-4 py-2">
                    <span class={`inline-flex px-1.5 py-0.5 rounded-full text-[10px] font-medium ${getOrderStatusColor(o.status)}`}>
                      {o.status.replace(/_/g, ' ')}
                    </span>
                  </td>
                  <td class="px-4 py-2 text-right font-medium text-gray-900 text-xs">{formatCurrency(o.totalAmount)}</td>
                  <td class="px-4 py-2 text-right font-bold text-xs">
                    {o.balanceDue > 0
                      ? <span class="text-red-600 font-mono">{formatCurrency(o.balanceDue)}</span>
                      : <span class="text-green-500 text-[10px]">Cleared</span>
                    }
                  </td>
                </tr>
              ))}
            </tbody>
            <tfoot class="bg-gray-50 border-t-2 border-gray-200">
              <tr>
                <td colspan="4" class="px-5 py-3 font-semibold text-gray-700 text-sm">Totals</td>
                <td class="px-5 py-3 text-right font-bold text-gray-900">{formatCurrency(totalBilled)}</td>
                <td class="px-5 py-3 text-right font-bold text-green-600">{formatCurrency(totalCollected)}</td>
                <td class="px-5 py-3 text-right font-bold text-red-600">{formatCurrency(totalOutstanding)}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      )}
    </div>

    <!-- Payment history -->
    {orders.some((o) => o.payments.length > 0) && (
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="p-5 border-b border-gray-100">
          <h2 class="font-semibold text-gray-900">Payment History</h2>
        </div>
        <div class="divide-y divide-gray-100">
          {orders.flatMap((o) =>
            o.payments.map((p) => ({ ...p, orderNumber: o.orderNumber, customerName: o.customer.name }))
          ).sort((a, b) => new Date(b.paidAt).getTime() - new Date(a.paidAt).getTime()).map((p) => (
            <div class="px-5 py-4 flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="w-9 h-9 bg-green-100 rounded-full flex items-center justify-center text-green-600 font-bold text-sm flex-shrink-0">
                  ₹
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-900">{p.customerName}</p>
                  <p class="text-xs text-gray-400 font-mono">{p.orderNumber}</p>
                  <p class="text-xs text-gray-400">{p.type} · {p.method}</p>
                </div>
              </div>
              <div class="text-right">
                <p class="font-bold text-green-600">{formatCurrency(p.amount)}</p>
                <p class="text-xs text-gray-400">{formatDate(p.paidAt)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</DashboardLayout>
