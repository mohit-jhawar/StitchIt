---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import db from '../../../lib/db';
import { formatDate } from '../../../lib/utils';

const user = Astro.locals.user;
if (!user || user.role !== 'TAILOR') return Astro.redirect('/dashboard');

const profile = await db.tailorProfile.findUnique({ where: { userId: user.id } });
if (!profile) return Astro.redirect('/login');

// Reviews for orders that were assigned to this tailor
const reviews = await db.review.findMany({
  where: { order: { tailorId: profile.id } },
  include: {
    customer: { select: { name: true } },
    order: { select: { orderNumber: true } },
  },
  orderBy: { createdAt: 'desc' },
});

const avgRating = reviews.length > 0
  ? reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length
  : 0;

const ratingCounts = [5, 4, 3, 2, 1].map((star) => ({
  star,
  count: reviews.filter((r) => r.rating === star).length,
}));
---

<DashboardLayout 
  title="My Reviews - StitchIt" 
  pageTitle="My Reviews"
  breadcrumbItems={[{ label: 'Reviews' }]}
>
  <div class="space-y-6">
    {reviews.length === 0 ? (
      <div class="bg-white rounded-2xl border border-slate-200/60 p-12 text-center shadow-sm">
        <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-slate-100 shadow-inner">
          <span class="text-2xl opacity-80">⭐</span>
        </div>
        <h3 class="text-base font-bold text-slate-900 uppercase tracking-tight">No Customer Feedback Yet</h3>
        <p class="text-slate-500 text-xs mt-2 max-w-[280px] mx-auto leading-relaxed">
          Your reviews and ratings will appear here once customers provide feedback on your completed orders.
        </p>
      </div>
    ) : (
      <>
        <!-- Summary Dashboard -->
        <div class="bg-white rounded-2xl border border-slate-200/60 p-6 shadow-sm">
          <div class="flex flex-col md:flex-row items-center gap-10">
            <!-- Large Score -->
            <div class="text-center flex-shrink-0 bg-slate-50/50 p-6 rounded-2xl border border-slate-100 min-w-[160px] shadow-inner">
              <p class="text-6xl font-black text-slate-900 leading-none tracking-tighter">{avgRating.toFixed(1)}</p>
              <div class="flex items-center justify-center gap-1 mt-4">
                {[1,2,3,4,5].map((star) => (
                  <span class={`text-xl ${star <= Math.round(avgRating) ? 'text-amber-400' : 'text-slate-200'}`}>★</span>
                ))}
              </div>
              <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-3">{reviews.length} Verified Reviews</p>
            </div>

            <!-- Distribution Chart -->
            <div class="flex-1 w-full space-y-2.5">
              {ratingCounts.map(({ star, count }) => (
                <div class="flex items-center gap-4">
                  <span class="text-[10px] font-bold text-slate-400 w-4 text-right">{star}</span>
                  <div class="flex-1 bg-slate-100 rounded-full h-2 overflow-hidden shadow-inner">
                    <div
                      class={`h-2 rounded-full transition-all duration-1000 ease-in-out ${star >= 4 ? 'bg-amber-400' : 'bg-slate-300'}`}
                      style={`width: ${reviews.length > 0 ? (count / reviews.length) * 100 : 0}%`}
                    />
                  </div>
                  <span class="text-[10px] font-bold text-slate-400 w-6">{count}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Review Feed -->
        <div class="grid gap-4">
          {reviews.map((review) => (
            <div class="bg-white rounded-2xl border border-slate-200/60 p-5 shadow-sm hover:shadow-md transition-all duration-200 group">
              <div class="flex items-start justify-between gap-6">
                <div class="flex items-center gap-4 min-w-0">
                  <div class="w-10 h-10 bg-indigo-50 border border-indigo-100 rounded-xl flex items-center justify-center text-indigo-600 font-bold text-sm flex-shrink-0 shadow-sm">
                    {review.customer.name.charAt(0).toUpperCase()}
                  </div>
                  <div class="min-w-0">
                    <p class="font-bold text-slate-900 text-sm truncate">{review.customer.name}</p>
                    <div class="flex items-center gap-2 mt-0.5">
                      <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest px-1.5 py-0.5 bg-slate-50 border border-slate-100 rounded-md">Order #{review.order.orderNumber}</span>
                      <span class="w-1 h-1 bg-slate-200 rounded-full"></span>
                      <span class="text-[9px] font-bold text-slate-400 uppercase tracking-tighter">{formatDate(review.createdAt)}</span>
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-0.5 flex-shrink-0 bg-amber-50/50 px-2 py-1 rounded-lg border border-amber-100/50">
                  {[1,2,3,4,5].map((star) => (
                    <span class={`text-sm ${star <= review.rating ? 'text-amber-400' : 'text-slate-200'}`}>★</span>
                  ))}
                </div>
              </div>
              {review.comment && (
                <div class="mt-4 pl-14 relative">
                  <div class="absolute left-12 top-0 bottom-0 w-0.5 bg-slate-100 rounded-full"></div>
                  <p class="text-xs text-slate-600 italic leading-relaxed">
                    "{review.comment}"
                  </p>
                </div>
              )}
            </div>
          ))}
        </div>
      </>
    )}
  </div>
</DashboardLayout>
