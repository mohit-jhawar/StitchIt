---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import db from '../../../lib/db';
import { formatDate, formatCurrency } from '../../../lib/utils';

const user = Astro.locals.user;
if (!user || user.role !== 'TAILOR') return Astro.redirect('/dashboard');

const profile = await db.tailorProfile.findUnique({
  where: { userId: user.id },
  include: { user: { select: { email: true, createdAt: true } } },
});
if (!profile) return Astro.redirect('/login');

const ordersCompleted = await db.order.count({ where: { tailorId: profile.id, status: 'DELIVERED' } });
const ordersActive = await db.order.count({ where: { tailorId: profile.id, status: { notIn: ['DELIVERED'] } } });
---

<DashboardLayout title="My Profile - StitchIt" pageTitle="My Profile">
  <div class="max-w-2xl space-y-4">
    <div>
      <h1 class="text-xl font-bold text-gray-900">My Profile</h1>
      <p class="text-gray-500 text-xs mt-0.5">Manage your tailor profile and work settings.</p>
    </div>

    <!-- Profile card -->
    <div class="bg-white rounded-xl border border-gray-200 p-4 shadow-sm">
      <div class="flex items-center gap-4">
        <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-indigo-600 rounded-xl flex items-center justify-center text-white text-2xl font-bold flex-shrink-0 shadow-lg shadow-indigo-500/20">
          {profile.name.charAt(0).toUpperCase()}
        </div>
        <div class="min-w-0">
          <h2 class="text-lg font-bold text-gray-900 truncate">{profile.name}</h2>
          <p class="text-xs text-gray-500 truncate">{profile.user.email}</p>
          {profile.specialization && (
            <p class="text-[10px] text-purple-600 font-bold uppercase tracking-wider mt-1">✂️ {profile.specialization}</p>
          )}
          <div class="flex items-center gap-2 mt-2">
            <span class="inline-flex items-center px-1.5 py-0.5 bg-purple-100 text-purple-700 rounded-md text-[9px] font-bold uppercase tracking-widest">
              Tailor
            </span>
            <span class="text-[9px] text-gray-400 font-medium">Joined {formatDate(profile.user.createdAt)}</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-4 gap-2 mt-4 pt-4 border-t border-gray-50 text-center">
        {[
          { label: 'Active', value: ordersActive },
          { label: 'Done', value: ordersCompleted },
          { label: 'Exp.', value: `${profile.experience}y` },
          { label: 'Cap/d', value: profile.dailyCapacity },
        ].map((s) => (
          <div class="bg-gray-50/50 p-2 rounded-lg border border-gray-100">
            <p class="text-base font-bold text-gray-900 leading-none">{s.value}</p>
            <p class="text-[9px] font-bold text-gray-400 uppercase tracking-tighter mt-1">{s.label}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Edit form -->
    <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm">
      <h3 class="text-sm font-bold text-gray-900 mb-4 uppercase tracking-wider">Edit Profile</h3>
      <form id="tailorProfileForm" class="space-y-4">
        <div class="flex flex-col gap-1">
          <label class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Full Name</label>
          <input name="name" type="text" value={profile.name} required
            class="w-full px-3 py-1.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-gray-50/30" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="flex flex-col gap-1">
            <label class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Phone</label>
            <input name="phone" type="tel" value={profile.phone || ''} placeholder="+91 98765 43210"
              class="w-full px-3 py-1.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-gray-50/30" />
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Experience (y)</label>
            <input name="experience" type="number" min="0" value={profile.experience}
              class="w-full px-3 py-1.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-gray-50/30" />
          </div>
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-[11px] font-bold text-gray-400 uppercase tracking-wider">Specialization</label>
          <input name="specialization" type="text" value={profile.specialization || ''}
            placeholder="e.g. Bridal wear, Suits, Casual"
            class="w-full px-3 py-1.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-gray-50/30" />
        </div>
        <div id="tailorProfileSuccess" class="hidden text-[11px] font-bold text-green-700 bg-green-50 border border-green-100 px-3 py-2 rounded-lg">
          Profile updated successfully!
        </div>
        <div id="tailorProfileError" class="hidden text-[11px] font-bold text-red-600 bg-red-50 border border-red-100 px-3 py-2 rounded-lg"></div>
        <button type="submit"
          class="w-full sm:w-auto px-6 py-2 bg-indigo-600 text-white rounded-lg text-xs font-bold uppercase tracking-widest hover:bg-indigo-700 transition-all shadow-md shadow-indigo-500/20 active:scale-95">
          Save Changes
        </button>
      </form>
    </div>
  </div>
</DashboardLayout>

<script define:vars={{ userId: user.id }}>
  document.getElementById('tailorProfileForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const successEl = document.getElementById('tailorProfileSuccess');
    const errorEl = document.getElementById('tailorProfileError');
    successEl.classList.add('hidden');
    errorEl.classList.add('hidden');

    const res = await fetch(`/api/users/${userId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: fd.get('name'),
        phone: fd.get('phone') || undefined,
        specialization: fd.get('specialization') || undefined,
        experience: parseInt(fd.get('experience') || '0'),
      }),
    });
    const data = await res.json();
    if (res.ok) {
      successEl.classList.remove('hidden');
    } else {
      errorEl.textContent = data.error || 'Update failed';
      errorEl.classList.remove('hidden');
    }
  });
</script>
