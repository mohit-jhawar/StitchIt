---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import db from '../../../lib/db';
import { formatCurrency, formatDate } from '../../../lib/utils';
import { TailorQuickActions } from '../../../components/dashboard/TailorQuickActions';

const user = Astro.locals.user;
if (!user || user.role !== 'TAILOR') return Astro.redirect('/dashboard');

const profile = await db.tailorProfile.findUnique({ where: { userId: user.id } });
if (!profile) return Astro.redirect('/login');

const [assignedOrders, todayOrders, completedOrders, upcomingAppts] = await Promise.all([
  db.order.count({ where: { tailorId: profile.id, status: { notIn: ['DELIVERED'] } } }),
  db.order.count({
    where: {
      tailorId: profile.id,
      createdAt: { gte: new Date(new Date().setHours(0,0,0,0)) },
    },
  }),
  db.order.count({ where: { tailorId: profile.id, status: 'DELIVERED' } }),
  db.appointment.findMany({
    where: { tailorId: profile.id, status: 'SCHEDULED', scheduledAt: { gte: new Date() } },
    orderBy: { scheduledAt: 'asc' },
    take: 3,
    include: { customer: { select: { name: true, phone: true } } },
  }),
]);

const activeOrders = await db.order.findMany({
  where: { tailorId: profile.id, status: { notIn: ['DELIVERED'] } },
  orderBy: { createdAt: 'desc' },
  take: 5,
  include: {
    customer: { select: { name: true } },
    items: { include: { service: true } },
  },
});
---

<DashboardLayout title="Tailor Dashboard - StitchIt" pageTitle="Dashboard">
  <div class="space-y-6">
    <!-- Welcome Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">
          {new Date().getHours() < 12 ? 'Good Morning' : new Date().getHours() < 17 ? 'Good Afternoon' : 'Good Evening'}, 
          <span class="text-indigo-600">{profile.name.split(' ')[0]}</span>! 👋
        </h1>
        <p class="text-sm text-gray-500 mt-1">
          {profile.specialization ? `Expert in ${profile.specialization}` : 'Ready for a productive day at the workshop!'}
        </p>
      </div>
      <div class="hidden md:flex items-center gap-2 px-3 py-1.5 bg-white border border-gray-100 rounded-xl shadow-sm">
        <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
        <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Workshop Active</span>
      </div>
    </div>

    <!-- Quick Actions -->
    <TailorQuickActions client:load tailorId={profile.id} />

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { label: 'Active Tasks', value: assignedOrders, icon: '🧵', color: 'bg-indigo-50 text-indigo-600', border: 'border-indigo-100/50' },
        { label: "Today's Intake", value: todayOrders, icon: '📋', color: 'bg-blue-50 text-blue-600', border: 'border-blue-100/50' },
        { label: 'Units Delivered', value: completedOrders, icon: '✅', color: 'bg-green-50 text-green-600', border: 'border-green-100/50' },
        { label: 'Total Earnings', value: formatCurrency(profile.totalEarnings), icon: '💰', color: 'bg-amber-50 text-amber-600', border: 'border-amber-100/50' },
      ].map((s) => (
        <div class={`bg-white rounded-2xl border ${s.border} p-4 shadow-sm hover:shadow-md transition-all group`}>
          <div class={`w-10 h-10 ${s.color} rounded-xl flex items-center justify-center text-xl mb-3 shadow-inner transform group-hover:scale-110 transition-transform`}>{s.icon}</div>
          <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">{s.label}</p>
          <p class="text-2xl font-black text-gray-900 mt-1">{s.value}</p>
        </div>
      ))}
    </div>

    <div class="grid lg:grid-cols-2 gap-6">
      <!-- Active orders -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden flex flex-col">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-50 bg-gray-50/30">
          <h2 class="text-xs font-black text-gray-900 uppercase tracking-widest">Active Orders</h2>
          <a href="/dashboard/tailor/orders" class="text-[10px] text-indigo-600 hover:text-indigo-800 font-black uppercase tracking-wider">View All →</a>
        </div>
        {activeOrders.length === 0 ? (
          <div class="p-12 text-center text-gray-400">
            <p class="text-4xl mb-3">📦</p>
            <p class="text-sm font-medium">No active orders right now</p>
          </div>
        ) : (
          <div class="divide-y divide-gray-50">
            {activeOrders.map((o) => (
              <div class="px-6 py-4 flex items-center justify-between hover:bg-indigo-50/20 transition-colors">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-mono font-bold text-indigo-600 text-[10px] px-1.5 py-0.5 bg-indigo-50 rounded">{o.orderNumber}</span>
                    <p class="text-sm font-bold text-gray-900">{o.customer.name}</p>
                  </div>
                  <p class="text-[10px] text-gray-400 mt-1.5 font-medium">{o.items.map(i => i.service.name).join(' • ')}</p>
                </div>
                <span class={`inline-flex px-2 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider
                  ${o.status === 'STITCHING' ? 'bg-orange-100 text-orange-700' :
                    o.status === 'CUTTING' ? 'bg-yellow-100 text-yellow-700' :
                    o.status === 'FITTING' ? 'bg-purple-100 text-purple-700' :
                    'bg-gray-100 text-gray-700'}`}>
                  {o.status.replace(/_/g, ' ')}
                </span>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Upcoming appointments -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden flex flex-col">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-50 bg-gray-50/30">
          <h2 class="text-xs font-black text-gray-900 uppercase tracking-widest">Upcoming Appointments</h2>
        </div>
        {upcomingAppts.length === 0 ? (
          <div class="p-12 text-center text-gray-400">
            <p class="text-4xl mb-3">📅</p>
            <p class="text-sm font-medium">No appointments today</p>
          </div>
        ) : (
          <div class="divide-y divide-gray-50 font-medium">
            {upcomingAppts.map((a) => (
              <div class="px-6 py-4 hover:bg-blue-50/20 transition-colors group">
                <div class="flex items-start justify-between">
                  <div>
                    <p class="font-bold text-gray-900 text-sm">{a.customer.name}</p>
                    <p class="text-[10px] text-indigo-500 font-black uppercase tracking-wider mt-1">{a.type.replace(/_/g, ' ')}</p>
                    <div class="flex items-center gap-1.5 text-[10px] text-gray-400 mt-1.5">
                      <span class="w-1.5 h-1.5 bg-blue-400 rounded-full"></span>
                      {new Date(a.scheduledAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' })}
                    </div>
                  </div>
                  <span class="inline-flex px-2 py-1 bg-blue-50 text-blue-700 rounded-lg text-[9px] font-black uppercase tracking-widest h-fit">
                    Scheduled
                  </span>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Profile stats bar -->
    <div class="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm">
      <h2 class="text-xs font-black text-gray-900 uppercase tracking-widest mb-4">Workshop Stats</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
        {[
          { label: 'Experience', value: `${profile.experience} years`, desc: 'Crafting excellence' },
          { label: 'Capacity', value: `${profile.dailyCapacity} orders`, desc: 'Daily throughput' },
          { label: 'Expertise', value: profile.specialization || 'Master Tailor', desc: 'Core focus' },
          { label: 'Tenure', value: formatDate(profile.createdAt), desc: 'Joined StitchShop' },
        ].map((item) => (
          <div class="flex flex-col items-center">
            <p class="text-[9px] text-gray-400 font-black uppercase tracking-widest">{item.label}</p>
            <p class="text-sm font-bold text-gray-900 mt-1">{item.value}</p>
            <p class="text-[8px] text-gray-400 mt-0.5">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</DashboardLayout>
