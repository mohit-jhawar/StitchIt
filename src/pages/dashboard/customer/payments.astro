---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import db from '../../../lib/db';
import { formatCurrency, formatDate, getOrderStatusColor } from '../../../lib/utils';

const user = Astro.locals.user;
if (!user || user.role !== 'CUSTOMER') return Astro.redirect('/dashboard');

const profile = await db.customerProfile.findUnique({ where: { userId: user.id } });
if (!profile) return Astro.redirect('/login');

const orders = await db.order.findMany({
  where: { customerId: profile.id },
  orderBy: { createdAt: 'desc' },
  include: {
    payments: { orderBy: { paidAt: 'desc' } },
    items: { include: { service: true } },
    tailor: { select: { name: true } },
  },
});

// Per-order financial calculations
const orderFinancials = orders.map((o) => {
  const totalPaid   = o.payments.reduce((s, p) => s + p.amount, 0);
  const balanceDue  = Math.max(0, o.totalAmount - totalPaid);
  const advancePaid = o.payments.filter((p) => p.type === 'ADVANCE').reduce((s, p) => s + p.amount, 0);
  const balancePaid = o.payments.filter((p) => p.type === 'BALANCE').reduce((s, p) => s + p.amount, 0);
  return { ...o, totalPaid, balanceDue, advancePaid, balancePaid };
});

// Summary
const totalBilled      = orders.reduce((s, o) => s + o.totalAmount, 0);
const totalPaid        = orderFinancials.reduce((s, o) => s + o.totalPaid, 0);
const totalDue         = orderFinancials.reduce((s, o) => s + o.balanceDue, 0);
const ordersWithDue    = orderFinancials.filter((o) => o.balanceDue > 0);
const allPayments      = orders
  .flatMap((o) => o.payments.map((p) => ({ ...p, orderNumber: o.orderNumber, serviceSummary: o.items.map((i) => i.service.name).join(', ') })))
  .sort((a, b) => new Date(b.paidAt).getTime() - new Date(a.paidAt).getTime());
---

<DashboardLayout title="My Payments - StitchIt" pageTitle="Billing & Payments">
  <div class="space-y-4">
    <div>
      <h1 class="text-xl font-bold text-gray-900">Billing & Payments</h1>
      <p class="text-gray-500 text-xs mt-1">See what you owe, what you've paid, and your history.</p>
    </div>

    <!-- Summary cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { label: 'Total Billed', value: formatCurrency(totalBilled), icon: '🧾', color: 'bg-indigo-50 text-indigo-600', border: 'border-indigo-200' },
        { label: 'Total Paid', value: formatCurrency(totalPaid), icon: '✅', color: 'bg-green-50 text-green-600', border: 'border-green-200' },
        { label: 'Balance Due', value: formatCurrency(totalDue), icon: '⏳', color: totalDue > 0 ? 'bg-red-50 text-red-600' : 'bg-green-50 text-green-600', border: totalDue > 0 ? 'border-red-200' : 'border-green-200' },
        { label: 'Loyalty Points', value: `${profile.loyaltyPoints} pts`, icon: '⭐', color: 'bg-amber-50 text-amber-600', border: 'border-amber-200' },
      ].map((s) => (
        <div class={`bg-white rounded-xl border ${s.border} p-3.5`}>
          <div class={`w-8 h-8 ${s.color} rounded-lg flex items-center justify-center text-lg mb-2`}>{s.icon}</div>
          <p class="text-[10px] text-gray-500 uppercase tracking-tight">{s.label}</p>
          <p class="text-xl font-bold text-gray-900 mt-0.5">{s.value}</p>
        </div>
      ))}
    </div>

    <!-- Outstanding dues alert -->
    {ordersWithDue.length > 0 && (
      <div class="bg-red-50 border border-red-200 rounded-xl p-4">
        <div class="flex items-start gap-3 mb-3">
          <span class="text-xl">🔔</span>
          <div>
            <h2 class="text-sm font-semibold text-red-900">Payments Due</h2>
            <p class="text-[10px] text-red-700">
              Outstanding balances on {ordersWithDue.length} orders. Total: <strong>{formatCurrency(totalDue)}</strong>
            </p>
          </div>
        </div>
        <div class="space-y-2">
          {ordersWithDue.map((o) => (
            <div class="bg-white rounded-lg border border-red-200 px-3 py-2 flex items-center justify-between">
              <div>
                <a href={`/dashboard/customer/orders/${o.id}`} class="font-mono font-semibold text-indigo-600 hover:underline text-[10px]">
                  {o.orderNumber}
                </a>
              </div>
              <div class="text-right">
                <p class="text-[10px] font-bold text-red-600 font-mono">Due: {formatCurrency(o.balanceDue)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {totalDue === 0 && orders.length > 0 && (
      <div class="bg-green-50 border border-green-200 rounded-xl p-5 flex items-center gap-3">
        <span class="text-2xl">🎉</span>
        <div>
          <p class="font-semibold text-green-900">All Paid Up!</p>
          <p class="text-sm text-green-700">You have no outstanding balances. Thank you!</p>
        </div>
      </div>
    )}

    <!-- Per-order billing breakdown -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="px-4 py-2.5 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Order-wise Billing</h2>
      </div>

      {orderFinancials.length === 0 ? (
        <div class="p-10 text-center text-gray-400">
          <p class="text-4xl mb-2">🧵</p>
          <p>No orders yet</p>
        </div>
      ) : (
        <div class="space-y-0 divide-y divide-gray-100">
          {orderFinancials.map((o) => (
            <div class="px-4 py-3 hover:bg-gray-50 transition-colors">
              <!-- Order header -->
              <div class="flex items-start justify-between gap-4 mb-3">
                <div>
                  <a href={`/dashboard/customer/orders/${o.id}`} class="font-mono font-semibold text-indigo-600 hover:underline text-sm">
                    {o.orderNumber}
                  </a>
                  <p class="text-[10px] text-gray-400">{formatDate(o.createdAt)}</p>
                  <p class="text-xs text-gray-600 mt-0.5">{o.items.map((i) => i.service.name).join(', ')}</p>
                </div>
                <span class={`inline-flex px-1.5 py-0.5 rounded-full text-[10px] font-medium flex-shrink-0 ${getOrderStatusColor(o.status)}`}>
                  {o.status.replace(/_/g, ' ')}
                </span>
              </div>

              <!-- Financial breakdown bar -->
              <div class="grid grid-cols-4 gap-3 mb-3">
                <div class="bg-gray-50 rounded-lg p-3 text-center">
                  <p class="text-xs text-gray-400">Total</p>
                  <p class="text-sm font-bold text-gray-900 mt-0.5">{formatCurrency(o.totalAmount)}</p>
                </div>
                <div class="bg-blue-50 rounded-lg p-3 text-center">
                  <p class="text-xs text-blue-500">Advance</p>
                  <p class="text-sm font-bold text-blue-700 mt-0.5">{formatCurrency(o.advancePaid)}</p>
                </div>
                <div class="bg-green-50 rounded-lg p-3 text-center">
                  <p class="text-xs text-green-500">Balance Paid</p>
                  <p class="text-sm font-bold text-green-700 mt-0.5">{formatCurrency(o.balancePaid)}</p>
                </div>
                <div class={`rounded-lg p-3 text-center ${o.balanceDue > 0 ? 'bg-red-50' : 'bg-green-50'}`}>
                  <p class={`text-xs ${o.balanceDue > 0 ? 'text-red-500' : 'text-green-500'}`}>
                    {o.balanceDue > 0 ? 'Due' : 'Cleared'}
                  </p>
                  <p class={`text-sm font-bold mt-0.5 ${o.balanceDue > 0 ? 'text-red-700' : 'text-green-700'}`}>
                    {o.balanceDue > 0 ? formatCurrency(o.balanceDue) : '✓ Paid'}
                  </p>
                </div>
              </div>

              <!-- Progress bar -->
              {o.totalAmount > 0 && (
                <div class="flex items-center gap-2">
                  <div class="flex-1 bg-gray-200 rounded-full h-2 overflow-hidden">
                    <div
                      class="bg-green-500 h-2 rounded-full transition-all"
                      style={`width: ${Math.min(100, (o.totalPaid / o.totalAmount) * 100).toFixed(1)}%`}
                    />
                  </div>
                  <span class="text-xs text-gray-400 flex-shrink-0">
                    {((o.totalPaid / o.totalAmount) * 100).toFixed(0)}% paid
                  </span>
                </div>
              )}

              <!-- Individual payments -->
              {o.payments.length > 0 && (
                <div class="mt-3 space-y-1">
                  {o.payments.map((p) => (
                    <div class="flex items-center justify-between text-xs text-gray-500">
                      <span>{p.type} · {p.method} · {formatDate(p.paidAt)}</span>
                      <span class="font-medium text-green-600">{formatCurrency(p.amount)}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {orders.length > 0 && (
        <div class="bg-gray-50 border-t-2 border-gray-200 px-4 py-2 flex items-center justify-between text-xs font-semibold">
          <span class="text-gray-700 uppercase tracking-tight">Overall Total</span>
          <div class="flex gap-4">
            <span class="text-gray-900">{formatCurrency(totalBilled)}</span>
            <span class="text-green-600">{formatCurrency(totalPaid)} Paid</span>
            <span class={totalDue > 0 ? 'text-red-600' : 'text-green-600'}>
              {totalDue > 0 ? `${formatCurrency(totalDue)} Due` : 'All Clear'}
            </span>
          </div>
        </div>
      )}
    </div>

    <!-- Payment history -->
    {allPayments.length > 0 && (
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-4 py-2.5 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">Payment History</h2>
        </div>
        <div class="divide-y divide-gray-100">
          {allPayments.map((p) => (
            <div class="px-4 py-2.5 flex items-center justify-between hover:bg-gray-50">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-green-50 rounded-full flex items-center justify-center text-green-700 font-bold text-xs flex-shrink-0">
                  ₹
                </div>
                <div>
                  <p class="text-xs font-semibold text-gray-900 truncate max-w-[150px]">{p.serviceSummary}</p>
                  <p class="text-[10px] text-gray-400 font-mono">{p.orderNumber} · {p.type}</p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-xs font-bold text-green-600">{formatCurrency(p.amount)}</p>
                <p class="text-[10px] text-gray-400">{formatDate(p.paidAt)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</DashboardLayout>
