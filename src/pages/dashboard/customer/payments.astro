---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import db from '../../../lib/db';
import { formatCurrency, formatDate, getOrderStatusColor } from '../../../lib/utils';

const user = Astro.locals.user;
if (!user || user.role !== 'CUSTOMER') return Astro.redirect('/dashboard');

const profile = await db.customerProfile.findUnique({ where: { userId: user.id } });
if (!profile) return Astro.redirect('/login');

const success = Astro.url.searchParams.get('success') === 'true';
const cancelled = Astro.url.searchParams.get('cancelled') === 'true';
const paidOrderNumber = Astro.url.searchParams.get('orderNumber');


const orders = await db.order.findMany({
  where: { customerId: profile.id },
  orderBy: { createdAt: 'desc' },
  include: {
    payments: { orderBy: { paidAt: 'desc' } },
    items: { include: { service: true } },
    tailor: { select: { name: true } },
  },
});

// Per-order financial calculations
const orderFinancials = orders.map((o) => {
  const totalPaid   = o.payments.reduce((s, p) => s + p.amount, 0);
  const balanceDue  = Math.max(0, o.totalAmount - totalPaid);
  const advancePaid = o.payments.filter((p) => p.type === 'ADVANCE').reduce((s, p) => s + p.amount, 0);
  const balancePaid = o.payments.filter((p) => p.type === 'BALANCE').reduce((s, p) => s + p.amount, 0);
  return { ...o, totalPaid, balanceDue, advancePaid, balancePaid };
});

// Summary
const totalBilled      = orders.reduce((s, o) => s + o.totalAmount, 0);
const totalPaid        = orderFinancials.reduce((s, o) => s + o.totalPaid, 0);
const totalDue         = orderFinancials.reduce((s, o) => s + o.balanceDue, 0);
const ordersWithDue    = orderFinancials.filter((o) => o.balanceDue > 0);
const allPayments      = orders
  .flatMap((o) => o.payments.map((p) => ({ ...p, orderNumber: o.orderNumber, serviceSummary: o.items.map((i) => i.service.name).join(', ') })))
  .sort((a, b) => new Date(b.paidAt).getTime() - new Date(a.paidAt).getTime());
---

<DashboardLayout title="My Payments - StitchIt" pageTitle="Billing & Payments">
  <div class="space-y-4">
    <div>
      <h1 class="text-xl font-bold text-gray-900">Billing & Payments</h1>
      <p class="text-gray-500 text-xs mt-1">See what you owe, what you've paid, and your history.</p>
    </div>

    <!-- Success Banner -->
    {success && (
      <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 flex items-start gap-3.5 shadow-sm">
        <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 text-sm font-bold flex-shrink-0">
          ✓
        </div>
        <div class="flex-1">
          <h3 class="text-sm font-semibold text-emerald-900">Payment Received!</h3>
          <p class="text-xs text-emerald-700 mt-0.5 font-sans">
            Thank you! Your payment for Order <strong class="font-mono font-semibold">#{paidOrderNumber || ''}</strong> has been successfully received. Your order status will be updated momentarily once the transaction clears.
          </p>
        </div>
        <button onclick="window.history.replaceState({}, document.title, window.location.pathname);" class="text-emerald-400 hover:text-emerald-600 transition-colors text-lg font-bold leading-none">&times;</button>
      </div>
    )}

    <!-- Cancelled Banner -->
    {cancelled && (
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 flex items-start gap-3.5 shadow-sm">
        <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 text-sm font-bold flex-shrink-0">
          ✕
        </div>
        <div class="flex-1">
          <h3 class="text-sm font-semibold text-amber-900">Payment Cancelled</h3>
          <p class="text-xs text-amber-700 mt-0.5 font-sans">
            The checkout session was cancelled. No charges were made, and your unpaid balance remains unchanged. If you faced any issues, feel free to try again.
          </p>
        </div>
        <button onclick="window.history.replaceState({}, document.title, window.location.pathname);" class="text-amber-400 hover:text-amber-600 transition-colors text-lg font-bold leading-none">&times;</button>
      </div>
    )}

    <!-- Summary cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { label: 'Total Billed', value: formatCurrency(totalBilled), icon: '🧾', color: 'bg-indigo-50 text-indigo-600', border: 'border-indigo-200' },
        { label: 'Total Paid', value: formatCurrency(totalPaid), icon: '✅', color: 'bg-green-50 text-green-600', border: 'border-green-200' },
        { label: 'Balance Due', value: formatCurrency(totalDue), icon: '⏳', color: totalDue > 0 ? 'bg-red-50 text-red-600' : 'bg-green-50 text-green-600', border: totalDue > 0 ? 'border-red-200' : 'border-green-200' },
        { label: 'Loyalty Points', value: `${profile.loyaltyPoints} pts`, icon: '⭐', color: 'bg-amber-50 text-amber-600', border: 'border-amber-200' },
      ].map((s) => (
        <div class={`bg-white rounded-xl border ${s.border} p-3.5`}>
          <div class={`w-8 h-8 ${s.color} rounded-lg flex items-center justify-center text-lg mb-2`}>{s.icon}</div>
          <p class="text-[10px] text-gray-500 uppercase tracking-tight">{s.label}</p>
          <p class="text-xl font-bold text-gray-900 mt-0.5">{s.value}</p>
        </div>
      ))}
    </div>

    <!-- Outstanding dues alert -->
    {ordersWithDue.length > 0 && (
      <div class="bg-red-50 border border-red-200 rounded-xl p-4">
        <div class="flex items-start gap-3 mb-3">
          <span class="text-xl">🔔</span>
          <div>
            <h2 class="text-sm font-semibold text-red-900">Payments Due</h2>
            <p class="text-[10px] text-red-700">
              Outstanding balances on {ordersWithDue.length} orders. Total: <strong>{formatCurrency(totalDue)}</strong>
            </p>
          </div>
        </div>
        <div class="space-y-2">
          {ordersWithDue.map((o) => (
            <div class="bg-white rounded-lg border border-red-200 px-3 py-2 flex items-center justify-between">
              <div>
                <a href={`/dashboard/customer/orders/${o.id}`} class="font-mono font-semibold text-indigo-600 hover:underline text-[10px]">
                  {o.orderNumber}
                </a>
              </div>
              <div class="flex items-center gap-3">
                <p class="text-[10px] font-bold text-red-600 font-mono">Due: {formatCurrency(o.balanceDue)}</p>
                <button
                  data-pay-btn
                  data-order-id={o.id}
                  data-amount={o.balanceDue}
                  data-order-number={o.orderNumber}
                  class="relative inline-flex items-center justify-center gap-1.5 px-3 py-1.5 text-[10px] font-bold text-white bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 rounded-lg shadow-sm hover:shadow transition-all focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed group"
                >
                  <svg class="animate-spin -ml-0.5 mr-1 h-3 w-3 text-white hidden group-disabled:block" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <svg class="w-3 h-3 group-disabled:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                  </svg>
                  <span>Pay Now</span>
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {totalDue === 0 && orders.length > 0 && (
      <div class="bg-green-50 border border-green-200 rounded-xl p-5 flex items-center gap-3">
        <span class="text-2xl">🎉</span>
        <div>
          <p class="font-semibold text-green-900">All Paid Up!</p>
          <p class="text-sm text-green-700">You have no outstanding balances. Thank you!</p>
        </div>
      </div>
    )}

    <!-- Per-order billing breakdown -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="px-4 py-2.5 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Order-wise Billing</h2>
      </div>

      {orderFinancials.length === 0 ? (
        <div class="p-10 text-center text-gray-400">
          <p class="text-4xl mb-2">🧵</p>
          <p>No orders yet</p>
        </div>
      ) : (
        <div class="space-y-0 divide-y divide-gray-100">
          {orderFinancials.map((o) => (
            <div class="px-4 py-3 hover:bg-gray-50 transition-colors">
              <!-- Order header -->
              <div class="flex items-start justify-between gap-4 mb-3">
                <div>
                  <a href={`/dashboard/customer/orders/${o.id}`} class="font-mono font-semibold text-indigo-600 hover:underline text-sm">
                    {o.orderNumber}
                  </a>
                  <p class="text-[10px] text-gray-400">{formatDate(o.createdAt)}</p>
                  <p class="text-xs text-gray-600 mt-0.5">{o.items.map((i) => i.service.name).join(', ')}</p>
                </div>
                <span class={`inline-flex px-1.5 py-0.5 rounded-full text-[10px] font-medium flex-shrink-0 ${getOrderStatusColor(o.status)}`}>
                  {o.status.replace(/_/g, ' ')}
                </span>
              </div>

              <!-- Financial breakdown bar -->
              <div class="grid grid-cols-4 gap-3 mb-3">
                <div class="bg-gray-50 rounded-lg p-3 text-center">
                  <p class="text-xs text-gray-400">Total</p>
                  <p class="text-sm font-bold text-gray-900 mt-0.5">{formatCurrency(o.totalAmount)}</p>
                </div>
                <div class="bg-blue-50 rounded-lg p-3 text-center">
                  <p class="text-xs text-blue-500">Advance</p>
                  <p class="text-sm font-bold text-blue-700 mt-0.5">{formatCurrency(o.advancePaid)}</p>
                </div>
                <div class="bg-green-50 rounded-lg p-3 text-center">
                  <p class="text-xs text-green-500">Balance Paid</p>
                  <p class="text-sm font-bold text-green-700 mt-0.5">{formatCurrency(o.balancePaid)}</p>
                </div>
                <div class={`rounded-lg p-3 text-center ${o.balanceDue > 0 ? 'bg-red-50' : 'bg-green-50'}`}>
                  <p class={`text-xs ${o.balanceDue > 0 ? 'text-red-500' : 'text-green-500'}`}>
                    {o.balanceDue > 0 ? 'Due' : 'Cleared'}
                  </p>
                  <p class={`text-sm font-bold mt-0.5 ${o.balanceDue > 0 ? 'text-red-700' : 'text-green-700'}`}>
                    {o.balanceDue > 0 ? formatCurrency(o.balanceDue) : '✓ Paid'}
                  </p>
                </div>
              </div>

              <!-- Progress bar -->
              {o.totalAmount > 0 && (
                <div class="flex items-center gap-2">
                  <div class="flex-1 bg-gray-200 rounded-full h-2 overflow-hidden">
                    <div
                      class="bg-green-500 h-2 rounded-full transition-all"
                      style={`width: ${Math.min(100, (o.totalPaid / o.totalAmount) * 100).toFixed(1)}%`}
                    />
                  </div>
                  <span class="text-xs text-gray-400 flex-shrink-0">
                    {((o.totalPaid / o.totalAmount) * 100).toFixed(0)}% paid
                  </span>
                </div>
              )}

              <!-- Individual payments -->
              {o.payments.length > 0 && (
                <div class="mt-3 space-y-1">
                  {o.payments.map((p) => (
                    <div class="flex items-center justify-between text-xs text-gray-500">
                      <span>{p.type} · {p.method} · {formatDate(p.paidAt)}</span>
                      <span class="font-medium text-green-600">{formatCurrency(p.amount)}</span>
                    </div>
                  ))}
                </div>
              )}

              {o.balanceDue > 0 && (
                <div class="mt-3 flex justify-end">
                  <button
                    data-pay-btn
                    data-order-id={o.id}
                    data-amount={o.balanceDue}
                    data-order-number={o.orderNumber}
                    class="relative inline-flex items-center justify-center gap-1.5 px-4 py-1.5 text-xs font-semibold text-white bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 hover:to-violet-700 rounded-lg shadow-sm hover:shadow transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed group"
                  >
                    <!-- Loading Spinner -->
                    <svg class="animate-spin -ml-1 mr-1.5 h-3.5 w-3.5 text-white hidden group-disabled:block" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <!-- Card Icon -->
                    <svg class="w-3.5 h-3.5 group-disabled:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                    </svg>
                    <span>Pay {formatCurrency(o.balanceDue)} Online</span>
                  </button>
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {orders.length > 0 && (
        <div class="bg-gray-50 border-t-2 border-gray-200 px-4 py-2 flex items-center justify-between text-xs font-semibold">
          <span class="text-gray-700 uppercase tracking-tight">Overall Total</span>
          <div class="flex gap-4">
            <span class="text-gray-900">{formatCurrency(totalBilled)}</span>
            <span class="text-green-600">{formatCurrency(totalPaid)} Paid</span>
            <span class={totalDue > 0 ? 'text-red-600' : 'text-green-600'}>
              {totalDue > 0 ? `${formatCurrency(totalDue)} Due` : 'All Clear'}
            </span>
          </div>
        </div>
      )}
    </div>

    <!-- Loyalty info banner -->
    <div class="bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-xl p-4 flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold text-amber-900">⭐ How Loyalty Points Work</p>
        <ul class="text-xs text-amber-700 mt-1 space-y-0.5">
          <li>• Earn <strong>1 point</strong> for every <strong>₹100</strong> you pay</li>
          <li>• Redeem <strong>100 points</strong> for a <strong>₹10 discount</strong> on any order</li>
          <li>• Ask the shop to apply your points when making a payment</li>
        </ul>
      </div>
      <div class="text-center ml-4 flex-shrink-0">
        <p class="text-3xl font-bold text-amber-600">{profile.loyaltyPoints}</p>
        <p class="text-xs text-amber-500 font-medium">points</p>
        <p class="text-[10px] text-amber-400">≈ ₹{Math.floor(profile.loyaltyPoints / 100) * 10} value</p>
      </div>
    </div>

    <!-- Payment history -->
    {allPayments.length > 0 && (
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-4 py-2.5 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-900">Payment History</h2>
        </div>
        <div class="divide-y divide-gray-100">
          {allPayments.map((p) => (
            <div class={`px-4 py-2.5 flex items-center justify-between hover:bg-gray-50 ${p.type === 'LOYALTY' ? 'bg-amber-50/50' : ''}`}>
              <div class="flex items-center gap-3">
                <div class={`w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 ${p.type === 'LOYALTY' ? 'bg-amber-100 text-amber-700' : 'bg-green-50 text-green-700'}`}>
                  {p.type === 'LOYALTY' ? '⭐' : '₹'}
                </div>
                <div>
                  <p class="text-xs font-semibold text-gray-900 truncate max-w-[150px]">
                    {p.type === 'LOYALTY' ? 'Loyalty Discount' : p.serviceSummary}
                  </p>
                  <p class="text-[10px] text-gray-400 font-mono">{p.orderNumber} · {p.type}</p>
                </div>
              </div>
              <div class="text-right">
                <p class={`text-xs font-bold ${p.type === 'LOYALTY' ? 'text-amber-600' : 'text-green-600'}`}>
                  {p.type === 'LOYALTY' ? '−' : ''}{formatCurrency(p.amount)}
                </p>
                <p class="text-[10px] text-gray-400">{formatDate(p.paidAt)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</DashboardLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const payButtons = document.querySelectorAll('[data-pay-btn]');

    payButtons.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        if (!target) return;

        const orderId = target.getAttribute('data-order-id');
        const amountStr = target.getAttribute('data-amount');
        const orderNumber = target.getAttribute('data-order-number');

        if (!orderId || !amountStr) return;

        const amount = parseFloat(amountStr);

        // Disable all pay buttons to prevent double-clicks
        payButtons.forEach((b) => {
          (b as HTMLButtonElement).disabled = true;
        });

        const spanEl = target.querySelector('span');
        const originalText = spanEl ? spanEl.textContent : 'Pay Online';
        if (spanEl) {
          spanEl.textContent = 'Redirecting to Stripe...';
        }

        try {
          const response = await fetch('/api/payments/checkout', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              orderId,
              amount,
            }),
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.error || data.message || 'Failed to initiate payment.');
          }

          if (data.checkoutUrl) {
            window.location.href = data.checkoutUrl;
          } else {
            throw new Error('No checkout URL returned from server.');
          }
        } catch (error: any) {
          console.error('Payment initialization error:', error);
          alert(error.message || 'An unexpected error occurred. Please try again.');
          
          // Re-enable buttons on error
          payButtons.forEach((b) => {
            (b as HTMLButtonElement).disabled = false;
          });
          if (spanEl) {
            spanEl.textContent = originalText;
          }
        }
      });
    });
  });
</script>
