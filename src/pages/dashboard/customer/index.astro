---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import db from '../../../lib/db';
import { formatCurrency, formatDate } from '../../../lib/utils';
import { OrderStatusBadge } from '../../../components/orders/OrderStatusBadge';

const user = Astro.locals.user;
if (!user || user.role !== 'CUSTOMER') return Astro.redirect('/dashboard');

const profile = await db.customerProfile.findUnique({ where: { userId: user.id } });
if (!profile) return Astro.redirect('/login');

const [recentOrders, measurements, appointments, unreadNotifs] = await Promise.all([
  db.order.findMany({
    where: { customerId: profile.id },
    orderBy: { createdAt: 'desc' },
    take: 5,
    include: { items: { include: { service: true } } },
  }),
  db.measurement.count({ where: { customerId: profile.id } }),
  db.appointment.count({ where: { customerId: profile.id, status: 'SCHEDULED' } }),
  db.notification.count({ where: { userId: user.id, isRead: false } }),
]);

const totalSpend = await db.payment.aggregate({
  _sum: { amount: true },
  where: { order: { customerId: profile.id } },
});
---

<DashboardLayout title="My Dashboard - StitchIt" pageTitle="Dashboard">
  <div class="space-y-4">
    <!-- Welcome banner -->
    <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-4 text-white">
      <h1 class="text-xl font-bold">Welcome back, {profile.name}! 👋</h1>
      <p class="text-indigo-200 text-xs mt-0.5">Here's an overview of your tailoring journey.</p>
    </div>

    <!-- Quick stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { label: 'Total Orders', value: recentOrders.length, href: '/dashboard/customer/orders', color: 'bg-indigo-50 text-indigo-600', icon: '📦' },
        { label: 'Measurements', value: measurements, href: '/dashboard/customer/measurements', color: 'bg-purple-50 text-purple-600', icon: '📏' },
        { label: 'Appointments', value: appointments, href: '/dashboard/customer/appointments', color: 'bg-blue-50 text-blue-600', icon: '📅' },
        { label: 'Total Spent', value: formatCurrency(totalSpend._sum.amount || 0), href: '/dashboard/customer/orders', color: 'bg-green-50 text-green-600', icon: '💰' },
      ].map((stat) => (
        <a href={stat.href} class="bg-white rounded-xl border border-gray-200 p-3.5 hover:shadow-md transition-all group">
          <div class={`w-8 h-8 ${stat.color} rounded-lg flex items-center justify-center text-lg mb-2`}>
            {stat.icon}
          </div>
          <p class="text-[10px] text-gray-500 uppercase tracking-tight">{stat.label}</p>
          <p class="text-xl font-bold text-gray-900 mt-0.5">{stat.value}</p>
        </a>
      ))}
    </div>

    <!-- Loyalty points -->
    <div class="bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-xl p-3.5 flex items-center justify-between">
      <div>
        <p class="text-[10px] font-medium text-amber-700 uppercase tracking-tight">Loyalty Points</p>
        <p class="text-2xl font-bold text-amber-900 mt-0.5">{profile.loyaltyPoints}</p>
        <p class="text-[10px] text-amber-600 mt-0.5">Points you can redeem!</p>
      </div>
      <div class="text-4xl">⭐</div>
    </div>

    <!-- Recent orders -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="flex items-center justify-between px-4 py-2.5 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-900">Recent Orders</h2>
        <a href="/dashboard/customer/orders" class="text-[10px] text-indigo-600 hover:underline font-medium">View all →</a>
      </div>
      {recentOrders.length === 0 ? (
        <div class="p-10 text-center text-gray-400">
          <p class="text-4xl mb-3">🧵</p>
          <p class="font-medium">No orders yet</p>
          <p class="text-sm mt-1">Place your first order and get it stitched perfectly!</p>
          <a href="/dashboard/customer/orders" class="inline-block mt-4 px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700">
            Place Order
          </a>
        </div>
      ) : (
        <div class="divide-y divide-gray-100">
          {recentOrders.map((order) => (
            <div class="flex items-center justify-between px-4 py-2 hover:bg-gray-50">
              <div>
                <p class="font-mono font-semibold text-indigo-600 text-[10px]">{order.orderNumber}</p>
                <p class="text-xs text-gray-600 mt-0.5">
                  {order.items.map((i) => i.service.name).join(', ')}
                </p>
                <p class="text-[10px] text-gray-400 mt-0.5">{formatDate(order.createdAt)}</p>
              </div>
              <div class="text-right">
                <span class={`inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-medium
                  ${order.status === 'DELIVERED' ? 'bg-green-100 text-green-700' :
                    order.status === 'READY' ? 'bg-emerald-100 text-emerald-700' :
                    order.status === 'PENDING' ? 'bg-gray-100 text-gray-700' :
                    'bg-indigo-100 text-indigo-700'}`}>
                  {order.status.replace(/_/g, ' ')}
                </span>
                <p class="text-xs font-bold text-gray-900 mt-0.5">{formatCurrency(order.totalAmount)}</p>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Quick actions -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {[
        { label: 'New Order', href: '/dashboard/customer/orders', icon: '➕', color: 'bg-indigo-600 text-white hover:bg-indigo-700' },
        { label: 'Add Measurement', href: '/dashboard/customer/measurements', icon: '📐', color: 'bg-purple-600 text-white hover:bg-purple-700' },
        { label: 'Book Appointment', href: '/dashboard/customer/appointments', icon: '📅', color: 'bg-blue-600 text-white hover:bg-blue-700' },
        { label: 'My Profile', href: '/dashboard/customer/profile', icon: '👤', color: 'bg-gray-700 text-white hover:bg-gray-800' },
      ].map((action) => (
        <a href={action.href}
          class={`flex flex-col items-center justify-center gap-1.5 p-3 rounded-xl font-medium text-xs transition-all ${action.color}`}>
          <span class="text-xl">{action.icon}</span>
          {action.label}
        </a>
      ))}
    </div>
  </div>
</DashboardLayout>
