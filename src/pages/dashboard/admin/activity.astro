---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import db from '../../../lib/db';
import { formatDateTime } from '../../../lib/utils';

const user = Astro.locals.user;
if (!user || user.role !== 'ADMIN') return Astro.redirect('/dashboard');

// Actions that are NOT relevant for admin tracking (auth / session events)
const EXCLUDED_ACTIONS = [
  'LOGIN_SUCCESS', 'LOGIN_FAILED', 'LOGIN_BLOCKED',
  'REGISTER_SUCCESS', 'VERIFY_SUCCESS', 'EMAIL_VERIFIED',
  'PASSWORD_RESET_REQUESTED', 'PASSWORD_RESET_OTP_VERIFIED', 'PASSWORD_RESET_SUCCESS',
];

// --- Parse filters from URL ---
const roleFilter   = Astro.url.searchParams.get('role')   || 'all'; // all | TAILOR | CUSTOMER
const userIdFilter = Astro.url.searchParams.get('userId') || '';
const actionFilter = Astro.url.searchParams.get('action') || '';
const fromFilter   = Astro.url.searchParams.get('from')   || '';
const toFilter     = Astro.url.searchParams.get('to')     || '';
const page         = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1'));
const PAGE_SIZE    = 25;

// --- Resolve userId set based on role filter ---
let filteredUserIds: string[];
if (userIdFilter) {
  filteredUserIds = [userIdFilter];
} else {
  const roleWhere =
    roleFilter === 'TAILOR'   ? { role: 'TAILOR'   as const } :
    roleFilter === 'CUSTOMER' ? { role: 'CUSTOMER' as const } :
    { role: { in: ['TAILOR', 'CUSTOMER'] as ('TAILOR' | 'CUSTOMER')[] } };

  const usersForRole = await db.user.findMany({ where: roleWhere, select: { id: true } });
  filteredUserIds = usersForRole.map((u) => u.id);
}

// --- Build AuditLog where clause (always exclude auth events) ---
const where: any = {
  userId: { in: filteredUserIds },
  action: { notIn: EXCLUDED_ACTIONS, ...(actionFilter ? { equals: actionFilter } : {}) },
};
if (actionFilter) where.action = actionFilter; // override to exact match when filter is set
if (fromFilter)   where.createdAt = { ...where.createdAt, gte: new Date(fromFilter) };
if (toFilter)     where.createdAt = { ...where.createdAt, lte: new Date(toFilter + 'T23:59:59') };

// Ensure EXCLUDED_ACTIONS is always applied even when actionFilter overrides
if (actionFilter) {
  where.action = { equals: actionFilter, notIn: EXCLUDED_ACTIONS };
}

// --- Fetch paginated logs + total count ---
const [total, logs] = await Promise.all([
  db.auditLog.count({ where }),
  db.auditLog.findMany({
    where,
    orderBy: { createdAt: 'desc' },
    skip: (page - 1) * PAGE_SIZE,
    take: PAGE_SIZE,
  }),
]);
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

// --- Enrich logs with user info ---
const uniqueUserIds = [...new Set(logs.map((l) => l.userId).filter(Boolean))] as string[];
const userProfiles = await db.user.findMany({
  where: { id: { in: uniqueUserIds } },
  select: {
    id: true, email: true, role: true,
    customerProfile: { select: { name: true } },
    tailorProfile:   { select: { name: true } },
  },
});
const userMap = Object.fromEntries(userProfiles.map((u) => [u.id, u]));

// --- All non-admin users for the "User" dropdown ---
const allUsers = await db.user.findMany({
  where: { role: { in: ['TAILOR', 'CUSTOMER'] } },
  select: {
    id: true, role: true,
    customerProfile: { select: { name: true } },
    tailorProfile:   { select: { name: true } },
  },
  orderBy: { createdAt: 'asc' },
});

// --- Distinct business actions for the "Action" dropdown ---
const distinctActions = await db.auditLog.findMany({
  where: { userId: { in: filteredUserIds }, action: { notIn: EXCLUDED_ACTIONS } },
  distinct: ['action'],
  select: { action: true },
  orderBy: { action: 'asc' },
});

// --- Today's activity count (business actions only) ---
const todayStart = new Date(); todayStart.setHours(0, 0, 0, 0);
const todayCount = await db.auditLog.count({
  where: { userId: { in: filteredUserIds }, action: { notIn: EXCLUDED_ACTIONS }, createdAt: { gte: todayStart } },
});

// --- Helpers ---
function getUserName(userId: string | null): string {
  if (!userId) return '—';
  const u = userMap[userId];
  if (!u) return 'Unknown';
  return u.customerProfile?.name || u.tailorProfile?.name || u.email;
}
function getUserRole(userId: string | null): string {
  if (!userId) return '';
  return userMap[userId]?.role || '';
}
function getUserEmail(userId: string | null): string {
  if (!userId) return '';
  return userMap[userId]?.email || '';
}

const ACTION_LABELS: Record<string, string> = {
  ORDER_CREATE:        'Created order',
  ORDER_UPDATE:        'Updated order',
  ORDER_DELETE:        'Deleted order',
  ORDER_STATUS_UPDATE: 'Changed order status',
  ORDER_ASSIGN:        'Assigned tailor to order',
  PAYMENT_RECEIVE:     'Recorded payment',
  MEASUREMENT_CREATE:  'Added measurements',
  MEASUREMENT_UPDATE:  'Updated measurements',
  MEASUREMENT_DELETE:  'Deleted measurements',
  APPOINTMENT_CREATE:  'Booked appointment',
  APPOINTMENT_UPDATE:  'Updated appointment',
  APPOINTMENT_DELETE:  'Cancelled appointment',
  REVIEW_CREATE:       'Submitted review',
  LOYALTY_ADJUST:      'Loyalty points adjusted',
};

const ACTION_BADGE: Record<string, string> = {
  ORDER_CREATE:        'bg-blue-100 text-blue-700',
  ORDER_UPDATE:        'bg-blue-50 text-blue-600',
  ORDER_DELETE:        'bg-red-100 text-red-700',
  ORDER_STATUS_UPDATE: 'bg-indigo-100 text-indigo-700',
  ORDER_ASSIGN:        'bg-indigo-50 text-indigo-600',
  PAYMENT_RECEIVE:     'bg-green-100 text-green-700',
  MEASUREMENT_CREATE:  'bg-cyan-100 text-cyan-700',
  MEASUREMENT_UPDATE:  'bg-cyan-50 text-cyan-600',
  MEASUREMENT_DELETE:  'bg-red-50 text-red-600',
  APPOINTMENT_CREATE:  'bg-purple-100 text-purple-700',
  APPOINTMENT_UPDATE:  'bg-purple-50 text-purple-600',
  APPOINTMENT_DELETE:  'bg-orange-100 text-orange-700',
  REVIEW_CREATE:       'bg-amber-100 text-amber-700',
  LOYALTY_ADJUST:      'bg-emerald-100 text-emerald-700',
};

function getActionLabel(action: string) { return ACTION_LABELS[action] || action.replace(/_/g, ' '); }
function getActionBadge(action: string) { return ACTION_BADGE[action] || 'bg-gray-100 text-gray-600'; }

function getDetails(action: string, detailsJson: string | null): string {
  if (!detailsJson) return '';
  try {
    const d = JSON.parse(detailsJson);
    switch (action) {
      case 'ORDER_STATUS_UPDATE':
        return `${d.from} → ${d.to}${d.note ? ` · "${d.note}"` : ''}`;
      case 'PAYMENT_RECEIVE':
        return `₹${d.amount} via ${d.method}${d.type ? ` (${d.type})` : ''}`;
      case 'APPOINTMENT_CREATE':
        return `${String(d.type || '').replace(/_/g, ' ')}${d.scheduledAt ? ' · ' + new Date(d.scheduledAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : ''}`;
      case 'APPOINTMENT_UPDATE':
        return d.from && d.status ? `${d.from} → ${d.status}` : (d.status || '');
      case 'APPOINTMENT_DELETE':
        return `${String(d.type || '').replace(/_/g, ' ')}${d.scheduledAt ? ' · ' + new Date(d.scheduledAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) : ''}`;
      case 'MEASUREMENT_CREATE':
      case 'MEASUREMENT_UPDATE':
        return d.name || '';
      case 'LOYALTY_ADJUST':
        return `${d.points > 0 ? '+' : ''}${d.points} pts — ${d.reason}`;
      case 'ORDER_ASSIGN':
        return 'Tailor assigned';
      default:
        return '';
    }
  } catch {
    return '';
  }
}

function getEntityLink(entityType: string | null, entityId: string | null): string | null {
  if (!entityType || !entityId) return null;
  if (entityType === 'ORDER') return `/dashboard/admin/orders/${entityId}`;
  return null;
}

function pageUrl(p: number) {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set('page', String(p));
  return '?' + params.toString();
}
function filterUrl(overrides: Record<string, string>) {
  const params = new URLSearchParams(Astro.url.searchParams);
  for (const [k, v] of Object.entries(overrides)) {
    if (v) params.set(k, v); else params.delete(k);
  }
  params.delete('page');
  return '?' + params.toString();
}
---

<DashboardLayout title="Activity Log - StitchIt" pageTitle="Activity Log">
  <div class="space-y-4">

    <!-- Header -->
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div>
        <h1 class="text-xl font-bold text-gray-900">Activity Log</h1>
        <p class="text-gray-500 text-xs mt-0.5">Data changes made by tailors and customers — newest first</p>
      </div>
      <div class="flex items-center gap-2 text-xs">
        <span class="px-2.5 py-1 bg-indigo-50 text-indigo-700 rounded-lg font-semibold">{total.toLocaleString()} total</span>
        <span class="px-2.5 py-1 bg-green-50 text-green-700 rounded-lg font-semibold">{todayCount} today</span>
      </div>
    </div>

    <!-- Filters -->
    <form method="GET" class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm space-y-3">

      <!-- Role tabs -->
      <div class="flex items-center gap-1 flex-wrap">
        <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400 mr-2">Show:</span>
        {[
          { key: 'all',      label: 'All' },
          { key: 'TAILOR',   label: 'Tailors' },
          { key: 'CUSTOMER', label: 'Customers' },
        ].map((r) => (
          <a
            href={filterUrl({ role: r.key, userId: '' })}
            class={`px-3 py-1 rounded-lg text-xs font-semibold transition-all ${
              roleFilter === r.key
                ? 'bg-indigo-600 text-white shadow-sm'
                : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
            }`}
          >
            {r.label}
          </a>
        ))}
      </div>

      <!-- Filters row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <!-- User -->
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">User</label>
          <select
            name="userId"
            class="w-full text-xs border border-gray-200 rounded-lg px-2.5 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400 bg-gray-50"
          >
            <option value="">All users</option>
            {(roleFilter === 'TAILOR'   ? allUsers.filter(u => u.role === 'TAILOR') :
              roleFilter === 'CUSTOMER' ? allUsers.filter(u => u.role === 'CUSTOMER') :
              allUsers
            ).map((u) => {
              const name = u.customerProfile?.name || u.tailorProfile?.name || u.id;
              return (
                <option value={u.id} selected={userIdFilter === u.id}>
                  {name} ({u.role})
                </option>
              );
            })}
          </select>
        </div>

        <!-- Action -->
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">Action</label>
          <select
            name="action"
            class="w-full text-xs border border-gray-200 rounded-lg px-2.5 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400 bg-gray-50"
          >
            <option value="">All actions</option>
            {distinctActions.map((a) => (
              <option value={a.action} selected={actionFilter === a.action}>
                {getActionLabel(a.action)}
              </option>
            ))}
          </select>
        </div>

        <!-- From -->
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">From</label>
          <input
            type="date" name="from" value={fromFilter}
            class="w-full text-xs border border-gray-200 rounded-lg px-2.5 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400 bg-gray-50"
          />
        </div>

        <!-- To -->
        <div>
          <label class="block text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">To</label>
          <input
            type="date" name="to" value={toFilter}
            class="w-full text-xs border border-gray-200 rounded-lg px-2.5 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400 bg-gray-50"
          />
        </div>
      </div>

      <input type="hidden" name="role" value={roleFilter} />

      <div class="flex items-center gap-2">
        <button
          type="submit"
          class="px-4 py-1.5 bg-indigo-600 text-white rounded-lg text-xs font-semibold hover:bg-indigo-700 transition-colors shadow-sm"
        >
          Apply
        </button>
        <a
          href="/dashboard/admin/activity"
          class="px-4 py-1.5 bg-gray-100 text-gray-600 rounded-lg text-xs font-semibold hover:bg-gray-200 transition-colors"
        >
          Reset
        </a>
        <span class="ml-auto text-[10px] text-gray-400">
          {total === 0 ? 'No results' : `${((page - 1) * PAGE_SIZE) + 1}–${Math.min(page * PAGE_SIZE, total)} of ${total.toLocaleString()}`}
        </span>
      </div>
    </form>

    <!-- Table -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead class="bg-gray-50/80 border-b border-gray-100">
            <tr>
              <th class="px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-gray-500 whitespace-nowrap">Date & Time</th>
              <th class="px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-gray-500">User</th>
              <th class="px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-gray-500">Role</th>
              <th class="px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-gray-500">Action</th>
              <th class="px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-gray-500">Details</th>
              <th class="px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-gray-500">Entity</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            {logs.map((log) => {
              const name     = getUserName(log.userId);
              const role     = getUserRole(log.userId);
              const email    = getUserEmail(log.userId);
              const details  = getDetails(log.action, log.details);
              const link     = getEntityLink(log.entityType, log.entityId);
              const roleCls  =
                role === 'TAILOR'   ? 'bg-purple-100 text-purple-700' :
                role === 'CUSTOMER' ? 'bg-green-100 text-green-700'   :
                'bg-gray-100 text-gray-600';

              return (
                <tr class="hover:bg-indigo-50/20 transition-colors">
                  <td class="px-4 py-2.5 whitespace-nowrap">
                    <div class="text-xs font-semibold text-gray-800">
                      {formatDateTime(log.createdAt).split(',')[0]}
                    </div>
                    <div class="text-[10px] text-gray-400">
                      {formatDateTime(log.createdAt).split(', ')[1]}
                    </div>
                  </td>

                  <td class="px-4 py-2.5 max-w-[160px]">
                    <div class="text-xs font-semibold text-gray-900 truncate">{name}</div>
                    <div class="text-[10px] text-gray-400 truncate">{email}</div>
                  </td>

                  <td class="px-4 py-2.5">
                    {role && (
                      <span class={`inline-flex px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider ${roleCls}`}>
                        {role}
                      </span>
                    )}
                  </td>

                  <td class="px-4 py-2.5">
                    <span class={`inline-flex px-2 py-0.5 rounded-full text-[9px] font-bold whitespace-nowrap ${getActionBadge(log.action)}`}>
                      {getActionLabel(log.action)}
                    </span>
                  </td>

                  <td class="px-4 py-2.5 text-xs text-gray-500 max-w-[200px] truncate" title={details}>
                    {details || <span class="text-gray-300">—</span>}
                  </td>

                  <td class="px-4 py-2.5">
                    {log.entityType && log.entityId ? (
                      link ? (
                        <a href={link} class="text-[10px] font-mono text-indigo-600 hover:text-indigo-800 hover:underline whitespace-nowrap">
                          {log.entityType} ↗
                        </a>
                      ) : (
                        <span class="text-[10px] font-mono text-gray-400">{log.entityType}</span>
                      )
                    ) : (
                      <span class="text-gray-300">—</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>

        {logs.length === 0 && (
          <div class="text-center py-16">
            <div class="text-4xl mb-3">📋</div>
            <p class="text-sm font-medium text-gray-500">No activity found</p>
            <p class="text-xs text-gray-400 mt-1">Try adjusting your filters or date range</p>
          </div>
        )}
      </div>
    </div>

    <!-- Pagination -->
    {totalPages > 1 && (
      <div class="flex items-center justify-between">
        <p class="text-xs text-gray-500">Page {page} of {totalPages}</p>
        <div class="flex items-center gap-1">
          {page > 1 && (
            <a href={pageUrl(page - 1)} class="px-3 py-1.5 text-xs font-medium bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
              ← Prev
            </a>
          )}
          {(() => {
            const start = Math.max(1, Math.min(page - 2, totalPages - 4));
            const pages = Array.from({ length: Math.min(5, totalPages) }, (_, i) => start + i).filter(p => p <= totalPages);
            return pages.map((p) => (
              <a
                href={pageUrl(p)}
                class={`px-3 py-1.5 text-xs font-medium rounded-lg transition-colors ${
                  p === page ? 'bg-indigo-600 text-white' : 'bg-white border border-gray-200 text-gray-600 hover:bg-gray-50'
                }`}
              >
                {p}
              </a>
            ));
          })()}
          {page < totalPages && (
            <a href={pageUrl(page + 1)} class="px-3 py-1.5 text-xs font-medium bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
              Next →
            </a>
          )}
        </div>
      </div>
    )}

  </div>
</DashboardLayout>
