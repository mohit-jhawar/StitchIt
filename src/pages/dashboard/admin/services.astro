---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import db from '../../../lib/db';
import { formatCurrency } from '../../../lib/utils';

const user = Astro.locals.user;
if (!user || user.role !== 'ADMIN') return Astro.redirect('/dashboard');

const services = await db.service.findMany({ orderBy: { createdAt: 'desc' } });
---

<DashboardLayout title="Services - StitchIt" pageTitle="Service Catalog">
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-bold text-gray-900">Services</h1>
        <p class="text-gray-500 text-xs mt-0.5">{services.length} services configured</p>
      </div>
      <button
        id="openAddService"
        class="px-3 py-1.5 bg-indigo-600 text-white rounded-lg text-xs font-medium hover:bg-indigo-700 transition-colors shadow-sm shadow-indigo-500/20"
      >
        + Add Service
      </button>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {services.map((svc) => (
        <div class="bg-white rounded-xl border border-gray-200 p-3.5 hover:shadow-md transition-all group flex flex-col justify-between">
          <div>
            <div class="flex items-start justify-between mb-2.5">
              <div class="min-w-0">
                <h3 class="font-bold text-gray-900 text-sm truncate">{svc.name}</h3>
                <span class="inline-flex mt-1 px-1.5 py-0.5 bg-indigo-50 text-indigo-700 rounded-full text-[10px] font-bold uppercase tracking-wider">{svc.category}</span>
              </div>
              <span class={`inline-flex px-1.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${svc.isActive ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500'}`}>
                {svc.isActive ? 'Active' : 'Inactive'}
              </span>
            </div>
            {svc.description && <p class="text-[11px] text-gray-500 mb-3 line-clamp-2 leading-relaxed">{svc.description}</p>}
            <div class="flex items-center justify-between mb-3 bg-gray-50/50 p-2 rounded-lg border border-gray-100">
              <span class="font-bold text-indigo-600 text-sm">{formatCurrency(svc.basePrice)}</span>
              <div class="flex items-center gap-2 text-[10px] text-gray-400 font-medium">
                <span class="flex items-center gap-1">⏱️ {svc.estimatedDays}d</span>
                <span class={`px-1.5 py-0.5 rounded font-bold uppercase tracking-tighter ${svc.complexity === 'SIMPLE' ? 'bg-green-100 text-green-700' : svc.complexity === 'MEDIUM' ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700'}`}>
                  {svc.complexity}
                </span>
              </div>
            </div>
          </div>
          <div class="flex gap-2 pt-2 border-t border-gray-50">
            <button
              class="edit-service flex-1 text-indigo-600 hover:bg-indigo-50 border border-indigo-100 rounded-lg py-1 text-[10px] font-bold uppercase tracking-wider transition-colors"
              data-service={JSON.stringify(svc)}
            >Edit</button>
            <button
              class="delete-service flex-1 text-red-500 hover:bg-red-50 border border-red-100 rounded-lg py-1 text-[10px] font-bold uppercase tracking-wider transition-colors"
              data-id={svc.id}
              data-name={svc.name}
            >Delete</button>
          </div>
        </div>
      ))}
    </div>

    {services.length === 0 && (
      <div class="bg-white rounded-xl border border-gray-200 p-8 text-center text-gray-400">
        <p class="font-bold text-sm text-gray-900">No services yet</p>
        <p class="text-xs mt-1">Add your first service to get started</p>
      </div>
    )}
  </div>

  <!-- Service Modal -->
  <div id="serviceModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/50" id="serviceModalOverlay"></div>
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
        <h2 id="serviceModalTitle" class="text-base font-semibold text-gray-900">Add Service</h2>
        <button id="closeServiceModal" class="text-gray-400 hover:text-gray-600 text-xl leading-none">&times;</button>
      </div>
      <form id="serviceForm" class="px-4 py-4 space-y-3">
        <input type="hidden" id="serviceId" value="" />
        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Service Name <span class="text-red-500">*</span></label>
            <input id="serviceName" type="text" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="e.g. Blouse Stitching" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Category <span class="text-red-500">*</span></label>
            <input id="serviceCategory" type="text" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="e.g. Women's, Men's, Kids" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Base Price (₹) <span class="text-red-500">*</span></label>
            <input id="servicePrice" type="number" min="1" step="0.01" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="0.00" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Estimated Days <span class="text-red-500">*</span></label>
            <input id="serviceDays" type="number" min="1" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="7" value="7" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Complexity</label>
            <select id="serviceComplexity" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="SIMPLE">Simple</option>
              <option value="MEDIUM" selected>Medium</option>
              <option value="COMPLEX">Complex</option>
            </select>
          </div>
          <div class="col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
            <textarea id="serviceDesc" rows="2" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Optional description of this service"></textarea>
          </div>
          <div class="col-span-2 flex items-center gap-2">
            <input id="serviceActive" type="checkbox" checked class="w-4 h-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" />
            <label for="serviceActive" class="text-sm text-gray-700">Active (available for new orders)</label>
          </div>
        </div>
        <div id="serviceError" class="hidden text-sm text-red-600 bg-red-50 rounded-lg px-3 py-2"></div>
        <div class="flex gap-3 pt-2">
          <button type="submit" id="serviceSubmitBtn" class="flex-1 bg-indigo-600 text-white py-2 rounded-lg text-sm font-medium hover:bg-indigo-700 transition-colors">
            Save Service
          </button>
          <button type="button" id="cancelServiceModal" class="flex-1 border border-gray-300 text-gray-700 py-2 rounded-lg text-sm font-medium hover:bg-gray-50 transition-colors">
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script>
  const modal = document.getElementById('serviceModal')!;
  const form = document.getElementById('serviceForm') as HTMLFormElement;
  const titleEl = document.getElementById('serviceModalTitle')!;
  const errorEl = document.getElementById('serviceError')!;
  const submitBtn = document.getElementById('serviceSubmitBtn')!;

  function openModal(svc?: any) {
    errorEl.classList.add('hidden');
    if (svc) {
      titleEl.textContent = 'Edit Service';
      (document.getElementById('serviceId') as HTMLInputElement).value = svc.id;
      (document.getElementById('serviceName') as HTMLInputElement).value = svc.name;
      (document.getElementById('serviceCategory') as HTMLInputElement).value = svc.category;
      (document.getElementById('servicePrice') as HTMLInputElement).value = svc.basePrice;
      (document.getElementById('serviceDays') as HTMLInputElement).value = svc.estimatedDays;
      (document.getElementById('serviceComplexity') as HTMLSelectElement).value = svc.complexity;
      (document.getElementById('serviceDesc') as HTMLTextAreaElement).value = svc.description || '';
      (document.getElementById('serviceActive') as HTMLInputElement).checked = svc.isActive;
    } else {
      titleEl.textContent = 'Add Service';
      form.reset();
      (document.getElementById('serviceId') as HTMLInputElement).value = '';
      (document.getElementById('serviceDays') as HTMLInputElement).value = '7';
      (document.getElementById('serviceComplexity') as HTMLSelectElement).value = 'MEDIUM';
      (document.getElementById('serviceActive') as HTMLInputElement).checked = true;
    }
    modal.classList.remove('hidden');
  }

  function closeModal() { modal.classList.add('hidden'); }

  document.getElementById('openAddService')!.addEventListener('click', () => openModal());
  document.getElementById('closeServiceModal')!.addEventListener('click', closeModal);
  document.getElementById('cancelServiceModal')!.addEventListener('click', closeModal);
  document.getElementById('serviceModalOverlay')!.addEventListener('click', closeModal);

  document.querySelectorAll('.edit-service').forEach((btn) => {
    btn.addEventListener('click', () => {
      const svc = JSON.parse((btn as HTMLElement).dataset.service!);
      openModal(svc);
    });
  });

  document.querySelectorAll('.delete-service').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = (btn as HTMLElement).dataset.id!;
      const name = (btn as HTMLElement).dataset.name!;
      if (!confirm(`Delete service "${name}"? This cannot be undone.`)) return;
      const res = await fetch(`/api/services/${id}`, { method: 'DELETE' });
      if (res.ok) {
        window.location.reload();
      } else {
        const data = await res.json().catch(() => ({}));
        alert(data.error || 'Failed to delete service');
      }
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    submitBtn.textContent = 'Saving...';
    submitBtn.setAttribute('disabled', 'true');

    const id = (document.getElementById('serviceId') as HTMLInputElement).value;
    const body = {
      name: (document.getElementById('serviceName') as HTMLInputElement).value.trim(),
      category: (document.getElementById('serviceCategory') as HTMLInputElement).value.trim(),
      basePrice: parseFloat((document.getElementById('servicePrice') as HTMLInputElement).value),
      estimatedDays: parseInt((document.getElementById('serviceDays') as HTMLInputElement).value),
      complexity: (document.getElementById('serviceComplexity') as HTMLSelectElement).value,
      description: (document.getElementById('serviceDesc') as HTMLTextAreaElement).value.trim() || undefined,
      isActive: (document.getElementById('serviceActive') as HTMLInputElement).checked,
    };

    const url = id ? `/api/services/${id}` : '/api/services';
    const method = id ? 'PUT' : 'POST';

    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });

    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      window.location.reload();
    } else {
      errorEl.textContent = data.error || 'Something went wrong';
      errorEl.classList.remove('hidden');
      submitBtn.textContent = 'Save Service';
      submitBtn.removeAttribute('disabled');
    }
  });
</script>
