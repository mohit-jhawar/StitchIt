---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import db from '../../../lib/db';
import { formatCurrency } from '../../../lib/utils';

const user = Astro.locals.user;
if (!user || user.role !== 'ADMIN') return Astro.redirect('/dashboard');

const now = new Date();
const selectedYear  = parseInt(Astro.url.searchParams.get('year')  || String(now.getFullYear()));
const selectedMonth = parseInt(Astro.url.searchParams.get('month') || String(now.getMonth() + 1));

const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];

function monthStart(y: number, m: number) { return new Date(y, m - 1, 1); }
function monthEnd(y: number, m: number)   { return new Date(y, m, 0, 23, 59, 59, 999); }

const mStart = monthStart(selectedYear, selectedMonth);
const mEnd   = monthEnd(selectedYear, selectedMonth);

// Revenue collected this month
const monthPaymentsAgg = await db.payment.aggregate({ _sum: { amount: true }, where: { createdAt: { gte: mStart, lte: mEnd } } });
const monthRevenue = monthPaymentsAgg._sum.amount || 0;

// Orders this month
const monthOrders = await db.order.findMany({ where: { createdAt: { gte: mStart, lte: mEnd } } });
const monthBilled = monthOrders.reduce((s, o) => s + o.totalAmount, 0);
const newOrderCount = monthOrders.length;

// Expenses this month
const monthExpenses = await db.expense.findMany({ where: { date: { gte: mStart, lte: mEnd } }, orderBy: { date: 'desc' } });
const monthExpenseTotal = monthExpenses.reduce((s, e) => s + e.amount, 0);

// Expense by category
const expenseByCat: Record<string, number> = {};
for (const e of monthExpenses) {
  const cat = e.category.toLowerCase();
  expenseByCat[cat] = (expenseByCat[cat] || 0) + e.amount;
}
const categoryData = Object.entries(expenseByCat).sort((a, b) => b[1] - a[1]);

// Net profit
const netProfit = monthRevenue - monthExpenseTotal;
const profitMargin = monthRevenue > 0 ? (netProfit / monthRevenue) * 100 : 0;
const netProfitStr   = (netProfit < 0 ? '-' : '+') + formatCurrency(Math.abs(netProfit));
const netLabelWord   = netProfit >= 0 ? 'Profit' : 'Loss';
const netAmountColor = netProfit >= 0 ? 'text-green-300' : 'text-red-300';
const netCardColor   = netProfit >= 0 ? 'bg-indigo-600' : 'bg-red-600';
const marginNote     = netProfit >= 0 ? `${profitMargin.toFixed(1)}% profit margin` : 'Expenses exceed income';

// All-time
const allRevAgg  = await db.payment.aggregate({ _sum: { amount: true } });
const allExpAgg  = await db.expense.aggregate({ _sum: { amount: true } });
const totalRevenue  = allRevAgg._sum.amount  || 0;
const totalExpenses = allExpAgg._sum.amount  || 0;
const totalProfit   = totalRevenue - totalExpenses;
const totalProfitColor  = totalProfit >= 0 ? 'text-indigo-600' : 'text-red-600';
const totalProfitBorder = totalProfit >= 0 ? 'border-indigo-200' : 'border-red-200';
const totalProfitBg     = totalProfit >= 0 ? 'bg-indigo-50'      : 'bg-red-50';
const totalProfitIcon   = totalProfit >= 0 ? '📈' : '📉';
const totalProfitStr    = formatCurrency(Math.abs(totalProfit));

// 12-month chart data
const chartMonths: Array<{ label: string; revenue: number; expenses: number; profit: number; isSelected: boolean }> = [];
for (let i = 11; i >= 0; i--) {
  const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
  const cy = d.getFullYear();
  const cm = d.getMonth() + 1;
  const [rev, exp] = await Promise.all([
    db.payment.aggregate({ _sum: { amount: true }, where: { createdAt: { gte: monthStart(cy, cm), lte: monthEnd(cy, cm) } } }),
    db.expense.aggregate({ _sum: { amount: true }, where: { date: { gte: monthStart(cy, cm), lte: monthEnd(cy, cm) } } }),
  ]);
  const r = rev._sum.amount || 0;
  const x = exp._sum.amount || 0;
  chartMonths.push({
    label: `${monthNames[cm - 1].slice(0, 3)} ${cy}`,
    revenue: r, expenses: x, profit: r - x,
    isSelected: cy === selectedYear && cm === selectedMonth,
  });
}
const maxChartVal = Math.max(...chartMonths.map(m => Math.max(m.revenue, m.expenses)), 1);

// Pre-compute bar heights and colours
const chartBars = chartMonths.map(m => ({
  ...m,
  revH:    Math.max(Math.round((m.revenue  / maxChartVal) * 100), 2),
  expH:    Math.max(Math.round((m.expenses / maxChartVal) * 100), 2),
  revBar:  m.isSelected ? 'bg-indigo-500' : 'bg-indigo-200 group-hover:bg-indigo-400',
  expBar:  m.isSelected ? 'bg-red-400'    : 'bg-red-100 group-hover:bg-red-300',
  labelCl: m.isSelected ? 'font-bold text-indigo-700' : 'text-gray-400',
  shortLbl: m.label.split(' ')[0],
}));

// Pre-compute expense category rows
const catIcons: Record<string, string> = {
  salary:'💵', tailor:'✂️', commission:'💳', fabric:'🧵',
  material:'🪡', materials:'🪡', rent:'🏠', utilities:'⚡',
  marketing:'📣', maintenance:'🔧', miscellaneous:'📦', other:'❓',
};
const catBarColor: Record<string, string> = {
  salary:'bg-purple-500', tailor:'bg-purple-500', commission:'bg-purple-400',
  fabric:'bg-amber-500',  material:'bg-amber-500', materials:'bg-amber-400',
  rent:'bg-blue-500', utilities:'bg-cyan-500', marketing:'bg-pink-500',
  maintenance:'bg-orange-500', miscellaneous:'bg-gray-500', other:'bg-gray-400',
};

const catRows = categoryData.map(([cat, amt]) => ({
  cat,
  amt,
  amtStr:  formatCurrency(amt),
  pct:     monthExpenseTotal > 0 ? (amt / monthExpenseTotal) * 100 : 0,
  pctStr:  monthExpenseTotal > 0 ? `${((amt / monthExpenseTotal) * 100).toFixed(0)}%` : '0%',
  icon:    catIcons[cat]    || '💼',
  barCol:  catBarColor[cat] || 'bg-indigo-400',
}));

// Available years
const firstOrder = await db.order.findFirst({ orderBy: { createdAt: 'asc' } });
const startYear = firstOrder ? new Date(firstOrder.createdAt).getFullYear() : selectedYear;
const years = Array.from({ length: now.getFullYear() - startYear + 1 }, (_, i) => startYear + i).reverse();
---

<DashboardLayout title="Profit & Loss - StitchIt" pageTitle="Profit & Loss">
  <div class="space-y-4">

    <!-- Header + month picker -->
    <div class="flex items-start justify-between flex-wrap gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Profit &amp; Loss Report</h1>
        <p class="text-gray-500 text-sm mt-1">Monthly income, expenses, and net profit overview.</p>
      </div>
      <form method="GET" class="flex items-center gap-2">
        <select name="month" class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
          {monthNames.map((name, i) => (
            <option value={i + 1} selected={selectedMonth === i + 1}>{name}</option>
          ))}
        </select>
        <select name="year" class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
          {years.map(y => (
            <option value={y} selected={selectedYear === y}>{y}</option>
          ))}
        </select>
        <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition-colors">View</button>
      </form>
    </div>

    <!-- Hero banner -->
    <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-4 text-white">
      <p class="text-indigo-200 text-xs font-medium">{monthNames[selectedMonth - 1]} {selectedYear}</p>
      <div class="grid grid-cols-3 gap-4 mt-3">
        <div>
          <p class="text-indigo-200 text-[10px] uppercase tracking-tight">Revenue Collected</p>
          <p class="text-2xl font-bold mt-0.5">{formatCurrency(monthRevenue)}</p>
          <p class="text-indigo-200 text-[10px] mt-0.5">{newOrderCount} orders · {formatCurrency(monthBilled)} billed</p>
        </div>
        <div>
          <p class="text-indigo-200 text-[10px] uppercase tracking-tight">Total Expenses</p>
          <p class="text-2xl font-bold mt-0.5">{formatCurrency(monthExpenseTotal)}</p>
          <p class="text-indigo-200 text-[10px] mt-0.5">{monthExpenses.length} entries</p>
        </div>
        <div>
          <p class="text-indigo-200 text-[10px] uppercase tracking-tight">Net {netLabelWord}</p>
          <p class={`text-2xl font-bold mt-0.5 ${netAmountColor}`}>{netProfitStr}</p>
          <p class="text-indigo-200 text-[10px] mt-0.5">{marginNote}</p>
        </div>
      </div>
    </div>

    <!-- All-time stats -->
    <div class="grid grid-cols-3 gap-4">
      <div class="bg-white rounded-xl border border-green-200 p-3.5 flex items-center gap-3">
        <div class="w-10 h-10 bg-green-50 rounded-xl flex items-center justify-center text-xl flex-shrink-0">💰</div>
        <div>
          <p class="text-xs text-gray-500">All-Time Revenue</p>
          <p class="text-xl font-bold text-green-600">{formatCurrency(totalRevenue)}</p>
        </div>
      </div>
      <div class="bg-white rounded-xl border border-red-200 p-3.5 flex items-center gap-3">
        <div class="w-10 h-10 bg-red-50 rounded-xl flex items-center justify-center text-xl flex-shrink-0">💸</div>
        <div>
          <p class="text-xs text-gray-500">All-Time Expenses</p>
          <p class="text-xl font-bold text-red-600">{formatCurrency(totalExpenses)}</p>
        </div>
      </div>
      <div class={`bg-white rounded-xl border ${totalProfitBorder} p-3.5 flex items-center gap-3`}>
        <div class={`w-10 h-10 ${totalProfitBg} rounded-xl flex items-center justify-center text-xl flex-shrink-0`}>{totalProfitIcon}</div>
        <div>
          <p class="text-xs text-gray-500">All-Time Net Profit</p>
          <p class={`text-xl font-bold ${totalProfitColor}`}>{totalProfitStr}</p>
        </div>
      </div>
    </div>

    <!-- 12-month bar chart -->
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <h2 class="text-sm font-semibold text-gray-900 mb-1">Revenue vs Expenses (Last 12 Months)</h2>
      <p class="text-[10px] text-gray-400 mb-4">Monthly comparison of income collected and expenses recorded.</p>
      <div class="flex items-end gap-1 h-40 overflow-x-auto pb-2">
        {chartBars.map(m => (
          <div class="flex flex-col items-center gap-1 flex-1 min-w-[52px] group relative">
            <div class="absolute bottom-full mb-2 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-xs rounded-lg px-2 py-1.5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-10 whitespace-nowrap text-center">
              <p class="font-medium">{m.label}</p>
              <p class="text-green-300">Rev: {formatCurrency(m.revenue)}</p>
              <p class="text-red-300">Exp: {formatCurrency(m.expenses)}</p>
              <p class={m.profit >= 0 ? 'text-blue-300' : 'text-orange-300'}>{m.profit >= 0 ? '+' : ''}{formatCurrency(m.profit)}</p>
            </div>
            <div class="flex items-end gap-0.5 w-full h-40">
              <div class={`flex-1 rounded-t-sm transition-all ${m.revBar}`} style={`height:${m.revH}%`} />
              <div class={`flex-1 rounded-t-sm transition-all ${m.expBar}`} style={`height:${m.expH}%`} />
            </div>
            <p class={`text-xs text-center leading-tight ${m.labelCl}`}>{m.shortLbl}</p>
          </div>
        ))}
      </div>
      <div class="flex items-center gap-4 mt-4 border-t border-gray-100 pt-4">
        <div class="flex items-center gap-2"><div class="w-3 h-3 rounded-sm bg-indigo-400"></div><span class="text-xs text-gray-500">Revenue</span></div>
        <div class="flex items-center gap-2"><div class="w-3 h-3 rounded-sm bg-red-300"></div><span class="text-xs text-gray-500">Expenses</span></div>
      </div>
    </div>

    <!-- Two column: breakdown + P&L summary -->
    <div class="grid lg:grid-cols-2 gap-6">

      <!-- Expense breakdown -->
      <div class="bg-white rounded-xl border border-gray-200 p-4">
        <h2 class="text-sm font-semibold text-gray-900 mb-3">Expense Breakdown — {monthNames[selectedMonth - 1]} {selectedYear}</h2>
        {catRows.length === 0 ? (
          <div class="text-center py-8 text-gray-400">
            <p class="text-3xl mb-2">📋</p>
            <p class="text-sm">No expenses recorded this month</p>
            <a href="/dashboard/admin/expenses" class="mt-3 inline-block text-xs text-indigo-600 hover:underline">+ Add expenses</a>
          </div>
        ) : (
          <div class="space-y-3">
            {catRows.map(row => (
              <div>
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm text-gray-700 capitalize">{row.icon} {row.cat}</span>
                  <span class="text-sm font-semibold text-gray-900">{row.amtStr} <span class="text-xs text-gray-400">({row.pctStr})</span></span>
                </div>
                <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
                  <div class={`h-full ${row.barCol} rounded-full`} style={`width:${row.pct}%`} />
                </div>
              </div>
            ))}
            <div class="border-t border-gray-100 pt-3 flex items-center justify-between">
              <span class="text-sm font-semibold text-gray-700">Total</span>
              <span class="text-sm font-bold text-red-600">{formatCurrency(monthExpenseTotal)}</span>
            </div>
          </div>
        )}
      </div>

      <!-- P&L summary card -->
      <div class="bg-white rounded-xl border border-gray-200 p-4 flex flex-col justify-between">
        <div>
          <h2 class="text-sm font-semibold text-gray-900 mb-3">P&amp;L Summary — {monthNames[selectedMonth - 1]} {selectedYear}</h2>
          <div class="space-y-2">
            <div class="bg-green-50 rounded-lg p-3">
              <p class="text-[10px] font-semibold text-green-700 uppercase tracking-tight mb-1.5">📥 Income</p>
              <div class="space-y-1.5">
                <div class="flex justify-between text-sm">
                  <span class="text-gray-600">Payments collected</span>
                  <span class="font-semibold text-green-700">{formatCurrency(monthRevenue)}</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="text-gray-600">Orders invoiced</span>
                  <span class="font-medium text-gray-500">{formatCurrency(monthBilled)}</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="text-gray-600">New orders</span>
                  <span class="font-medium text-gray-700">{newOrderCount}</span>
                </div>
              </div>
            </div>
            <div class="bg-red-50 rounded-lg p-3">
              <p class="text-[10px] font-semibold text-red-700 uppercase tracking-tight mb-1.5">📤 Expenses</p>
              <div class="space-y-1.5">
                {catRows.length === 0 ? (
                  <p class="text-xs text-gray-400">No expenses this month</p>
                ) : catRows.map(row => (
                  <div class="flex justify-between text-sm">
                    <span class="text-gray-600 capitalize">{row.cat}</span>
                    <span class="font-semibold text-red-600">{row.amtStr}</span>
                  </div>
                ))}
                <div class="border-t border-red-200 pt-1.5 flex justify-between text-sm font-semibold">
                  <span class="text-gray-700">Total Expenses</span>
                  <span class="text-red-700">{formatCurrency(monthExpenseTotal)}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Net result -->
        <div class={`mt-3 rounded-lg p-4 text-center ${netCardColor}`}>
          <p class="text-white/80 text-[10px] uppercase tracking-tight">Net {netLabelWord}</p>
          <p class="text-white text-3xl font-bold mt-0.5">{netProfitStr}</p>
          <p class="text-white/70 text-[10px] mt-0.5">{marginNote}</p>
        </div>
      </div>
    </div>

    <!-- Expense log table -->
    {monthExpenses.length > 0 && (
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden text-xs">
        <div class="px-4 py-2.5 border-b border-gray-100 flex items-center justify-between">
          <h2 class="text-sm font-semibold text-gray-900">Expense Log — {monthNames[selectedMonth - 1]}</h2>
          <a href="/dashboard/admin/expenses" class="text-[10px] text-indigo-600 hover:underline font-medium">Manage →</a>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="text-left px-4 py-2 font-medium text-gray-500">Category</th>
                <th class="text-left px-4 py-2 font-medium text-gray-500">Description</th>
                <th class="text-left px-4 py-2 font-medium text-gray-500">Date</th>
                <th class="text-right px-4 py-2 font-medium text-gray-500">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {monthExpenses.map(e => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-2">
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-medium bg-gray-100 text-gray-700 capitalize">{e.category}</span>
                  </td>
                  <td class="px-4 py-2 text-gray-600">{e.description || '—'}</td>
                  <td class="px-4 py-2 text-gray-500 text-[10px]">{new Date(e.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' })}</td>
                  <td class="px-4 py-2 text-right font-semibold text-red-600">{formatCurrency(e.amount)}</td>
                </tr>
              ))}
            </tbody>
            <tfoot class="bg-gray-50 border-t-2 border-gray-200">
              <tr>
                <td colspan="3" class="px-5 py-3 font-semibold text-gray-700">Total</td>
                <td class="px-5 py-3 text-right font-bold text-red-700">{formatCurrency(monthExpenseTotal)}</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    )}

    <!-- Quick links -->
    <div class="grid grid-cols-3 gap-3">
      <a href="/dashboard/admin/expenses" class="bg-white rounded-xl border border-red-100 hover:border-red-300 p-3.5 flex items-center gap-3 hover:shadow-sm transition-all group">
        <span class="text-2xl">💸</span>
        <div>
          <p class="font-semibold text-gray-900 text-xs group-hover:text-indigo-700 transition-colors">Expenses</p>
          <p class="text-[10px] text-gray-400 mt-0.5">Manage bills</p>
        </div>
      </a>
      <a href="/dashboard/admin/finances" class="bg-white rounded-xl border border-indigo-100 hover:border-indigo-300 p-3.5 flex items-center gap-3 hover:shadow-sm transition-all group">
        <span class="text-2xl">📊</span>
        <div>
          <p class="font-semibold text-gray-900 text-xs group-hover:text-indigo-700 transition-colors">Finances</p>
          <p class="text-[10px] text-gray-400 mt-0.5">Dues & payouts</p>
        </div>
      </a>
      <a href="/dashboard/admin/analytics" class="bg-white rounded-xl border border-purple-100 hover:border-purple-300 p-3.5 flex items-center gap-3 hover:shadow-sm transition-all group">
        <span class="text-2xl">📈</span>
        <div>
          <p class="font-semibold text-gray-900 text-xs group-hover:text-indigo-700 transition-colors">Analytics</p>
          <p class="text-[10px] text-gray-400 mt-0.5">Insights</p>
        </div>
      </a>
    </div>

  </div>
</DashboardLayout>
