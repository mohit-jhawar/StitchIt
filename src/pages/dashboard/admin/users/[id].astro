---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import db from '../../../../lib/db';
import { formatDate, formatDateTime, formatCurrency, getOrderStatusColor } from '../../../../lib/utils';

const admin = Astro.locals.user;
if (!admin || admin.role !== 'ADMIN') return Astro.redirect('/dashboard');

const { id } = Astro.params;
if (!id) return Astro.redirect('/dashboard/admin/users');

const targetUser = await db.user.findUnique({
  where: { id },
  include: {
    customerProfile: {
      include: {
        orders: {
          orderBy: { createdAt: 'desc' },
          include: { items: { include: { service: true } }, payments: true },
        },
        measurements: { orderBy: { createdAt: 'desc' } },
        reviews: { orderBy: { createdAt: 'desc' }, include: { order: { select: { orderNumber: true } } } },
        complaints: { orderBy: { createdAt: 'desc' } },
        appointments: { orderBy: { scheduledAt: 'desc' }, take: 10, include: { tailor: { select: { name: true } } } },
      },
    },
    tailorProfile: {
      include: {
        orders: {
          orderBy: { createdAt: 'desc' },
          include: { customer: { select: { name: true } }, items: { include: { service: true } }, payments: true },
        },
        appointments: { orderBy: { scheduledAt: 'desc' }, take: 10, include: { customer: { select: { name: true } } } },
      },
    },
    adminProfile: true,
  },
});

if (!targetUser || targetUser.role === 'ADMIN') return Astro.redirect('/dashboard/admin/users');

const isTailor = targetUser.role === 'TAILOR';
const profile = isTailor ? targetUser.tailorProfile : targetUser.customerProfile;
if (!profile) return Astro.redirect('/dashboard/admin/users');

// Tailor-specific stats
const tailorOrders = isTailor ? targetUser.tailorProfile!.orders : [];
const tailorActiveOrders = tailorOrders.filter((o) => o.status !== 'DELIVERED').length;
const tailorCompletedOrders = tailorOrders.filter((o) => o.status === 'DELIVERED').length;
const tailorReviews = isTailor
  ? await db.review.findMany({
      where: { order: { tailorId: targetUser.tailorProfile!.id } },
      include: { customer: { select: { name: true } }, order: { select: { orderNumber: true } } },
      orderBy: { createdAt: 'desc' },
    })
  : [];
const tailorAvgRating = tailorReviews.length > 0
  ? tailorReviews.reduce((s, r) => s + r.rating, 0) / tailorReviews.length
  : 0;

// Customer-specific stats
const customerOrders = !isTailor ? targetUser.customerProfile!.orders : [];
const customerTotalSpent = customerOrders.reduce((s, o) => s + o.payments.reduce((ps, p) => ps + p.amount, 0), 0);
const customerActiveOrders = customerOrders.filter((o) => o.status !== 'DELIVERED').length;
---

<DashboardLayout title={`${isTailor ? 'Tailor' : 'Customer'} Profile - StitchIt`} pageTitle="User Detail">
  <div class="space-y-6">
    <!-- Back link -->
    <a href="/dashboard/admin/users" class="text-sm text-gray-500 hover:text-indigo-600 transition-colors flex items-center gap-1">
      ← Back to Users
    </a>

    <!-- Profile card -->
    <div class="bg-white rounded-2xl border border-gray-200 p-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="flex items-center gap-5">
          <div class={`w-20 h-20 rounded-2xl flex items-center justify-center text-white text-3xl font-bold flex-shrink-0 ${isTailor ? 'bg-gradient-to-br from-purple-500 to-indigo-600' : 'bg-gradient-to-br from-green-500 to-emerald-600'}`}>
            {profile.name.charAt(0).toUpperCase()}
          </div>
          <div>
            <h1 class="text-2xl font-bold text-gray-900">{profile.name}</h1>
            <p class="text-gray-500">{targetUser.email}</p>
            <div class="flex items-center gap-2 mt-2">
              <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${isTailor ? 'bg-purple-100 text-purple-700' : 'bg-green-100 text-green-700'}`}>
                {targetUser.role}
              </span>
              {isTailor && targetUser.tailorProfile?.specialization && (
                <span class="text-sm text-purple-600 font-medium">✂️ {targetUser.tailorProfile.specialization}</span>
              )}
              <span class="text-xs text-gray-400">Joined {formatDate(targetUser.createdAt)}</span>
            </div>
          </div>
        </div>

        <!-- Quick actions -->
        <div class="flex gap-2">
          <button
            id="editBtn"
            class="px-4 py-2 text-sm font-medium text-indigo-600 border border-indigo-300 rounded-lg hover:bg-indigo-50 transition-colors"
          >
            Edit Profile
          </button>
          <button
            id="deleteBtn"
            class="px-4 py-2 text-sm font-medium text-red-600 border border-red-300 rounded-lg hover:bg-red-50 transition-colors"
          >
            Delete User
          </button>
        </div>
      </div>

      <!-- Contact info -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6 pt-5 border-t border-gray-100">
        <div>
          <p class="text-xs text-gray-400 uppercase tracking-wide">Phone</p>
          <p class="text-sm font-medium text-gray-900 mt-1">{profile.phone || '—'}</p>
        </div>
        {!isTailor && targetUser.customerProfile?.address && (
          <div class="col-span-2">
            <p class="text-xs text-gray-400 uppercase tracking-wide">Address</p>
            <p class="text-sm font-medium text-gray-900 mt-1">{targetUser.customerProfile.address}</p>
          </div>
        )}
        {isTailor && (
          <>
            <div>
              <p class="text-xs text-gray-400 uppercase tracking-wide">Experience</p>
              <p class="text-sm font-medium text-gray-900 mt-1">{targetUser.tailorProfile!.experience} years</p>
            </div>
            <div>
              <p class="text-xs text-gray-400 uppercase tracking-wide">Daily Capacity</p>
              <p class="text-sm font-medium text-gray-900 mt-1">{targetUser.tailorProfile!.dailyCapacity} orders/day</p>
            </div>
          </>
        )}
      </div>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      {isTailor ? (
        <>
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <p class="text-sm text-gray-500">Active Orders</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{tailorActiveOrders}</p>
          </div>
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <p class="text-sm text-gray-500">Completed</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{tailorCompletedOrders}</p>
          </div>
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <p class="text-sm text-gray-500">Total Earnings</p>
            <p class="text-2xl font-bold text-green-600 mt-1">{formatCurrency(targetUser.tailorProfile!.totalEarnings)}</p>
          </div>
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <p class="text-sm text-gray-500">Avg Rating</p>
            <p class="text-2xl font-bold text-amber-500 mt-1">
              {tailorReviews.length > 0 ? `${tailorAvgRating.toFixed(1)} ★` : '—'}
            </p>
          </div>
        </>
      ) : (
        <>
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <p class="text-sm text-gray-500">Active Orders</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{customerActiveOrders}</p>
          </div>
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <p class="text-sm text-gray-500">Total Orders</p>
            <p class="text-2xl font-bold text-gray-900 mt-1">{customerOrders.length}</p>
          </div>
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <p class="text-sm text-gray-500">Total Spent</p>
            <p class="text-2xl font-bold text-green-600 mt-1">{formatCurrency(customerTotalSpent)}</p>
          </div>
          <div class="bg-white rounded-xl border border-gray-200 p-5">
            <p class="text-sm text-gray-500">Loyalty Points</p>
            <p class="text-2xl font-bold text-amber-500 mt-1">{targetUser.customerProfile!.loyaltyPoints} pts</p>
          </div>
        </>
      )}
    </div>

    <!-- Orders -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="p-5 border-b border-gray-100">
        <h2 class="font-semibold text-gray-900">{isTailor ? 'Assigned Orders' : 'Orders'}</h2>
      </div>
      {(isTailor ? tailorOrders : customerOrders).length === 0 ? (
        <div class="p-8 text-center text-gray-400">No orders yet</div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="text-left px-5 py-3 font-medium text-gray-500">Order #</th>
                {isTailor && <th class="text-left px-5 py-3 font-medium text-gray-500">Customer</th>}
                <th class="text-left px-5 py-3 font-medium text-gray-500">Services</th>
                <th class="text-left px-5 py-3 font-medium text-gray-500">Status</th>
                <th class="text-left px-5 py-3 font-medium text-gray-500">Amount</th>
                <th class="text-left px-5 py-3 font-medium text-gray-500">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {(isTailor ? tailorOrders : customerOrders).map((o: any) => (
                <tr class="hover:bg-gray-50">
                  <td class="px-5 py-3 font-mono text-indigo-600 font-medium">
                    <a href={`/dashboard/admin/orders/${o.id}`}>{o.orderNumber}</a>
                  </td>
                  {isTailor && <td class="px-5 py-3 text-gray-700">{o.customer?.name}</td>}
                  <td class="px-5 py-3 text-gray-600 text-xs">{o.items.map((i: any) => i.service.name).join(', ')}</td>
                  <td class="px-5 py-3">
                    <span class={`inline-flex px-2 py-0.5 rounded-full text-xs font-medium ${getOrderStatusColor(o.status)}`}>
                      {o.status.replace(/_/g, ' ')}
                    </span>
                  </td>
                  <td class="px-5 py-3 font-medium">{formatCurrency(o.totalAmount)}</td>
                  <td class="px-5 py-3 text-gray-500">{formatDate(o.createdAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- Appointments -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="p-5 border-b border-gray-100">
        <h2 class="font-semibold text-gray-900">Appointments</h2>
      </div>
      {(isTailor ? targetUser.tailorProfile!.appointments : targetUser.customerProfile!.appointments).length === 0 ? (
        <div class="p-8 text-center text-gray-400">No appointments</div>
      ) : (
        <div class="divide-y divide-gray-100">
          {(isTailor ? targetUser.tailorProfile!.appointments : targetUser.customerProfile!.appointments).map((a: any) => (
            <div class="px-5 py-4 flex items-center justify-between">
              <div>
                <p class="font-medium text-gray-900">{a.type.replace(/_/g, ' ')}</p>
                <p class="text-xs text-gray-400 mt-0.5">{formatDateTime(a.scheduledAt)}</p>
                {!isTailor && a.tailor && <p class="text-xs text-gray-500">With: {a.tailor.name}</p>}
                {isTailor && a.customer && <p class="text-xs text-gray-500">Customer: {a.customer.name}</p>}
              </div>
              <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${
                a.status === 'COMPLETED' ? 'bg-green-100 text-green-700' :
                a.status === 'CANCELLED' ? 'bg-red-100 text-red-700' :
                a.status === 'NO_SHOW' ? 'bg-gray-100 text-gray-600' :
                'bg-blue-100 text-blue-700'
              }`}>
                {a.status}
              </span>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Measurements (customers only) -->
    {!isTailor && (
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="p-5 border-b border-gray-100">
          <h2 class="font-semibold text-gray-900">Measurements</h2>
        </div>
        {targetUser.customerProfile!.measurements.length === 0 ? (
          <div class="p-8 text-center text-gray-400">No measurements saved</div>
        ) : (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 p-5">
            {targetUser.customerProfile!.measurements.map((m) => (
              <div class="border border-gray-200 rounded-xl p-4">
                <div class="flex items-center justify-between mb-3">
                  <h3 class="font-semibold text-gray-900">{m.name}</h3>
                  <span class="text-xs text-gray-400">{formatDate(m.createdAt)}</span>
                </div>
                <div class="grid grid-cols-3 gap-2">
                  {[
                    { label: 'Chest', value: m.chest },
                    { label: 'Waist', value: m.waist },
                    { label: 'Hip', value: m.hip },
                    { label: 'Shoulder', value: m.shoulder },
                    { label: 'Sleeve', value: m.sleeve },
                    { label: 'Length', value: m.length },
                    { label: 'Inseam', value: m.inseam },
                    { label: 'Neck', value: m.neck },
                  ].filter((item) => item.value != null).map((item) => (
                    <div class="bg-gray-50 rounded-lg p-1.5 text-center">
                      <p class="text-xs text-gray-400">{item.label}</p>
                      <p class="text-sm font-semibold text-gray-900">{item.value}"</p>
                    </div>
                  ))}
                </div>
                {m.notes && <p class="text-xs text-gray-500 mt-2 italic">{m.notes}</p>}
              </div>
            ))}
          </div>
        )}
      </div>
    )}

    <!-- Reviews (tailors — reviews they received) -->
    {isTailor && (
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="p-5 border-b border-gray-100">
          <h2 class="font-semibold text-gray-900">
            Reviews Received
            {tailorReviews.length > 0 && (
              <span class="ml-2 text-sm font-normal text-amber-500">
                {tailorAvgRating.toFixed(1)} ★ avg
              </span>
            )}
          </h2>
        </div>
        {tailorReviews.length === 0 ? (
          <div class="p-8 text-center text-gray-400">No reviews yet</div>
        ) : (
          <div class="divide-y divide-gray-100">
            {tailorReviews.map((r) => (
              <div class="px-5 py-4 flex items-start justify-between gap-4">
                <div>
                  <p class="font-medium text-gray-900">{r.customer.name}</p>
                  <p class="text-xs text-gray-400 font-mono">{r.order.orderNumber}</p>
                  {r.comment && <p class="text-sm text-gray-600 mt-1">{r.comment}</p>}
                </div>
                <div class="flex-shrink-0 text-right">
                  <div class="flex gap-0.5">
                    {[1,2,3,4,5].map((star) => (
                      <span class={`text-base ${star <= r.rating ? 'text-amber-400' : 'text-gray-200'}`}>★</span>
                    ))}
                  </div>
                  <p class="text-xs text-gray-400 mt-1">{formatDate(r.createdAt)}</p>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    )}

    <!-- Customer complaints -->
    {!isTailor && targetUser.customerProfile!.complaints.length > 0 && (
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="p-5 border-b border-gray-100">
          <h2 class="font-semibold text-gray-900">Complaints</h2>
        </div>
        <div class="divide-y divide-gray-100">
          {targetUser.customerProfile!.complaints.map((c) => (
            <div class="px-5 py-4">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-medium text-gray-900">{c.subject}</p>
                  <p class="text-sm text-gray-600 mt-0.5">{c.description}</p>
                  {c.resolution && (
                    <p class="text-sm text-green-700 bg-green-50 rounded-lg px-3 py-1.5 mt-2">
                      <strong>Resolution:</strong> {c.resolution}
                    </p>
                  )}
                </div>
                <div class="flex-shrink-0 text-right">
                  <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${
                    c.status === 'RESOLVED' ? 'bg-green-100 text-green-700' :
                    c.status === 'CLOSED' ? 'bg-gray-100 text-gray-600' :
                    c.status === 'IN_PROGRESS' ? 'bg-blue-100 text-blue-700' :
                    'bg-red-100 text-red-700'
                  }`}>{c.status}</span>
                  <p class="text-xs text-gray-400 mt-1">{formatDate(c.createdAt)}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Edit Profile Modal -->
    <div id="editModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
      <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="editModalBackdrop"></div>
      <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg">
        <div class="flex items-center justify-between p-6 border-b border-gray-100">
          <h2 class="text-lg font-bold text-gray-900">Edit Profile</h2>
          <button id="closeEditModal" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg hover:bg-gray-100">
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </button>
        </div>
        <form id="editForm" class="p-6 space-y-4">
          <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-gray-700">Full Name</label>
            <input name="name" type="text" value={profile.name} required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-gray-700">Phone</label>
            <input name="phone" type="tel" value={profile.phone || ''}
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
          </div>
          {!isTailor && (
            <div class="flex flex-col gap-1">
              <label class="text-sm font-medium text-gray-700">Address</label>
              <input name="address" type="text" value={targetUser.customerProfile?.address || ''}
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
          )}
          {isTailor && (
            <>
              <div class="flex flex-col gap-1">
                <label class="text-sm font-medium text-gray-700">Specialization</label>
                <input name="specialization" type="text" value={targetUser.tailorProfile?.specialization || ''}
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
              </div>
              <div class="flex flex-col gap-1">
                <label class="text-sm font-medium text-gray-700">Experience (years)</label>
                <input name="experience" type="number" min="0" value={targetUser.tailorProfile?.experience || 0}
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
              </div>
            </>
          )}
          <div id="editSuccess" class="hidden text-sm text-green-700 bg-green-50 border border-green-200 px-3 py-2 rounded-lg">
            Profile updated successfully!
          </div>
          <div id="editError" class="hidden text-sm text-red-600 bg-red-50 border border-red-200 px-3 py-2 rounded-lg"></div>
          <div class="flex gap-3 pt-2">
            <button type="submit"
              class="flex-1 px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-semibold hover:bg-indigo-700 transition-colors">
              Save Changes
            </button>
            <button type="button" id="cancelEdit"
              class="px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-50 transition-colors">
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</DashboardLayout>

<script define:vars={{ userId: id, isTailor }}>
  // Edit modal
  const editModal = document.getElementById('editModal');
  document.getElementById('editBtn').addEventListener('click', () => editModal.classList.remove('hidden'));
  document.getElementById('closeEditModal').addEventListener('click', () => editModal.classList.add('hidden'));
  document.getElementById('cancelEdit').addEventListener('click', () => editModal.classList.add('hidden'));
  document.getElementById('editModalBackdrop').addEventListener('click', () => editModal.classList.add('hidden'));

  document.getElementById('editForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const successEl = document.getElementById('editSuccess');
    const errorEl = document.getElementById('editError');
    successEl.classList.add('hidden');
    errorEl.classList.add('hidden');

    const body = {
      name: fd.get('name'),
      phone: fd.get('phone') || undefined,
      ...(isTailor
        ? {
            specialization: fd.get('specialization') || undefined,
            experience: parseInt(fd.get('experience') || '0'),
          }
        : {
            address: fd.get('address') || undefined,
          }),
    };

    const res = await fetch(`/api/users/${userId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json();
    if (res.ok) {
      successEl.classList.remove('hidden');
      setTimeout(() => window.location.reload(), 1000);
    } else {
      errorEl.textContent = data.error || 'Update failed';
      errorEl.classList.remove('hidden');
    }
  });

  // Delete user
  document.getElementById('deleteBtn').addEventListener('click', async () => {
    if (!confirm('Are you sure you want to permanently delete this user and all their data? This cannot be undone.')) return;
    const res = await fetch(`/api/users/${userId}`, { method: 'DELETE' });
    if (res.ok) {
      window.location.href = '/dashboard/admin/users';
    } else {
      alert('Failed to delete user. Please try again.');
    }
  });
</script>
