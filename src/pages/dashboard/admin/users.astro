---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import db from '../../../lib/db';
import { formatDate, formatCurrency } from '../../../lib/utils';

const user = Astro.locals.user;
if (!user || user.role !== 'ADMIN') return Astro.redirect('/dashboard');

const tab = (Astro.url.searchParams.get('tab') || 'all') as 'all' | 'tailors' | 'customers';

const [allUsers, tailors, customers] = await Promise.all([
  db.user.findMany({
    orderBy: { createdAt: 'desc' },
    include: {
      customerProfile: { select: { name: true, phone: true, loyaltyPoints: true } },
      tailorProfile: { select: { name: true, phone: true, specialization: true, totalEarnings: true } },
      adminProfile: { select: { name: true } },
      _count: { select: { notifications: true } },
    },
  }),
  db.tailorProfile.findMany({
    orderBy: { createdAt: 'desc' },
    include: {
      user: { select: { id: true, email: true, createdAt: true } },
      _count: { select: { orders: true } },
    },
  }),
  db.customerProfile.findMany({
    orderBy: { createdAt: 'desc' },
    include: {
      user: { select: { id: true, email: true, createdAt: true } },
      _count: { select: { orders: true, measurements: true } },
    },
  }),
]);

function getName(u: typeof allUsers[0]) {
  return u.customerProfile?.name || u.tailorProfile?.name || u.adminProfile?.name || '-';
}

const roleColor: Record<string, string> = {
  ADMIN: 'bg-indigo-100 text-indigo-700',
  CUSTOMER: 'bg-green-100 text-green-700',
  TAILOR: 'bg-purple-100 text-purple-700',
};
---

<DashboardLayout title="Users - StitchIt" pageTitle="User Management">
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-bold text-gray-900">Users</h1>
        <p class="text-gray-500 text-xs mt-0.5">{allUsers.length} total — {tailors.length} tailors, {customers.length} customers</p>
      </div>
      <button
        id="openAddUser"
        class="px-3 py-1.5 bg-indigo-600 text-white rounded-lg text-xs font-medium hover:bg-indigo-700 transition-colors shadow-sm shadow-indigo-500/20"
      >
        + Add User
      </button>
    </div>

    <!-- Summary cards -->
    <div class="grid grid-cols-3 gap-3">
      {[
        { label: 'Total Users', value: allUsers.length, color: 'text-indigo-600', bgColor: 'bg-indigo-50', icon: '👥' },
        { label: 'Tailors', value: tailors.length, color: 'text-purple-600', bgColor: 'bg-purple-50', icon: '✂️' },
        { label: 'Customers', value: customers.length, color: 'text-green-600', bgColor: 'bg-green-50', icon: '🛍️' },
      ].map((s) => (
        <div class="bg-white rounded-xl border border-gray-200 p-3 hover:shadow-md transition-all group flex items-center gap-3">
          <div class={`w-8 h-8 ${s.bgColor} rounded-lg flex items-center justify-center text-sm shadow-sm group-hover:scale-110 transition-transform`}>{s.icon}</div>
          <div class="min-w-0">
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider truncate">{s.label}</p>
            <p class="text-lg font-bold text-gray-900 leading-tight truncate">{s.value}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Role tabs -->
    <div class="flex gap-1 border-b border-gray-100 overflow-x-auto scrollbar-hide">
      {[
        { key: 'all', label: 'All Users', count: allUsers.length },
        { key: 'tailors', label: 'Tailors', count: tailors.length },
        { key: 'customers', label: 'Customers', count: customers.length },
      ].map((t) => (
        <a
          href={`?tab=${t.key}`}
          class={`px-3 py-2 text-[11px] font-bold uppercase tracking-wider border-b-2 -mb-px whitespace-nowrap transition-all ${
            tab === t.key
              ? 'border-indigo-600 text-indigo-600'
              : 'border-transparent text-gray-400 hover:text-gray-600 hover:border-gray-200'
          }`}
        >
          {t.label}
          <span class={`ml-1.5 px-1.5 py-0.5 rounded-full text-[9px] font-bold ${tab === t.key ? 'bg-indigo-100 text-indigo-600' : 'bg-gray-50 text-gray-400'}`}>{t.count}</span>
        </a>
      ))}
    </div>

    <!-- All Users tab -->
    {tab === 'all' && (
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead class="bg-gray-50/50 border-b border-gray-100">
              <tr>
                <th class="px-4 py-2.5 font-bold text-gray-900 text-[10px] uppercase tracking-wider">Name</th>
                <th class="px-4 py-2.5 font-bold text-gray-900 text-[10px] uppercase tracking-wider">Email</th>
                <th class="px-4 py-2.5 font-bold text-gray-900 text-[10px] uppercase tracking-wider">Role</th>
                <th class="px-4 py-2.5 font-bold text-gray-900 text-[10px] uppercase tracking-wider">Phone</th>
                <th class="px-4 py-2.5 font-bold text-gray-900 text-[10px] uppercase tracking-wider">Joined</th>
                <th class="px-4 py-2.5"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              {allUsers.map((u) => (
                <tr class="hover:bg-indigo-50/30 transition-colors">
                  <td class="px-4 py-2.5 text-xs font-bold text-gray-900">{getName(u)}</td>
                  <td class="px-4 py-2.5 text-xs text-gray-600 truncate max-w-[150px]">{u.email}</td>
                  <td class="px-4 py-2.5">
                    <span class={`inline-flex px-1.5 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider ${roleColor[u.role]}`}>
                      {u.role}
                    </span>
                  </td>
                  <td class="px-4 py-2.5 text-xs text-gray-500">{u.customerProfile?.phone || u.tailorProfile?.phone || '-'}</td>
                  <td class="px-4 py-2.5 text-[10px] text-gray-400 font-medium">{formatDate(u.createdAt)}</td>
                  <td class="px-4 py-2.5 text-right">
                    {u.role !== 'ADMIN' && (
                      <a href={`/dashboard/admin/users/${u.id}`} class="px-2 py-1 bg-white border border-gray-200 rounded text-[9px] font-bold uppercase tracking-wider text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50 transition-all">
                        View
                      </a>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          {allUsers.length === 0 && <div class="text-center py-8 text-gray-400 text-xs">No users found</div>}
        </div>
      </div>
    )}

    <!-- Tailors tab -->
    {tab === 'tailors' && (
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Name</th>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Email</th>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Specialization</th>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Phone</th>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Orders</th>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Total Earnings</th>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Joined</th>
                <th class="px-6 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {tailors.map((t) => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 py-4 font-medium text-gray-900">{t.name}</td>
                  <td class="px-6 py-4 text-gray-600">{t.user.email}</td>
                  <td class="px-6 py-4 text-gray-600">{t.specialization || <span class="text-gray-400">—</span>}</td>
                  <td class="px-6 py-4 text-gray-500">{t.phone || '—'}</td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2 py-0.5 bg-purple-50 text-purple-700 rounded-full text-xs font-medium">
                      {t._count.orders} orders
                    </span>
                  </td>
                  <td class="px-6 py-4 font-medium text-green-600">{formatCurrency(t.totalEarnings)}</td>
                  <td class="px-6 py-4 text-gray-500">{formatDate(t.user.createdAt)}</td>
                  <td class="px-6 py-4 text-right">
                    <a href={`/dashboard/admin/users/${t.user.id}`} class="text-indigo-600 hover:text-indigo-800 font-medium text-xs">
                      View →
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          {tailors.length === 0 && <div class="text-center py-8 text-gray-400">No tailors found</div>}
        </div>
      </div>
    )}

    <!-- Customers tab -->
    {tab === 'customers' && (
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Name</th>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Email</th>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Phone</th>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Orders</th>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Measurements</th>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Loyalty Pts</th>
                <th class="text-left px-6 py-3 font-medium text-gray-500">Joined</th>
                <th class="px-6 py-3"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {customers.map((c) => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 py-4 font-medium text-gray-900">{c.name}</td>
                  <td class="px-6 py-4 text-gray-600">{c.user.email}</td>
                  <td class="px-6 py-4 text-gray-500">{c.phone || '—'}</td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2 py-0.5 bg-green-50 text-green-700 rounded-full text-xs font-medium">
                      {c._count.orders} orders
                    </span>
                  </td>
                  <td class="px-6 py-4 text-gray-600">{c._count.measurements}</td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2 py-0.5 bg-amber-50 text-amber-700 rounded-full text-xs font-medium">
                      {c.loyaltyPoints} pts
                    </span>
                  </td>
                  <td class="px-6 py-4 text-gray-500">{formatDate(c.user.createdAt)}</td>
                  <td class="px-6 py-4 text-right">
                    <a href={`/dashboard/admin/users/${c.user.id}`} class="text-indigo-600 hover:text-indigo-800 font-medium text-xs">
                      View →
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          {customers.length === 0 && <div class="text-center py-8 text-gray-400">No customers found</div>}
        </div>
      </div>
    )}
  </div>

  <!-- Add User Modal -->
  <div id="addUserModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/50" id="addUserOverlay"></div>
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-md">
      <div class="flex items-center justify-between p-6 border-b border-gray-100">
        <h2 class="text-lg font-semibold text-gray-900">Add New User</h2>
        <button id="closeAddUser" class="text-gray-400 hover:text-gray-600 text-xl leading-none">&times;</button>
      </div>
      <form id="addUserForm" class="p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Full Name <span class="text-red-500">*</span></label>
          <input id="newUserName" type="text" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Full name" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email <span class="text-red-500">*</span></label>
          <input id="newUserEmail" type="email" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="email@example.com" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Password <span class="text-red-500">*</span></label>
          <input id="newUserPassword" type="password" required minlength="6" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Min 6 characters" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Role <span class="text-red-500">*</span></label>
          <select id="newUserRole" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="CUSTOMER">Customer</option>
            <option value="TAILOR">Tailor</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
          <input id="newUserPhone" type="tel" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Optional" />
        </div>
        <div id="addUserError" class="hidden text-sm text-red-600 bg-red-50 rounded-lg px-3 py-2"></div>
        <div class="flex gap-3 pt-2">
          <button type="submit" id="addUserSubmitBtn" class="flex-1 bg-indigo-600 text-white py-2 rounded-lg text-sm font-medium hover:bg-indigo-700 transition-colors">
            Create User
          </button>
          <button type="button" id="cancelAddUser" class="flex-1 border border-gray-300 text-gray-700 py-2 rounded-lg text-sm font-medium hover:bg-gray-50 transition-colors">
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script>
  const modal = document.getElementById('addUserModal')!;
  const form = document.getElementById('addUserForm') as HTMLFormElement;
  const errorEl = document.getElementById('addUserError')!;
  const submitBtn = document.getElementById('addUserSubmitBtn')!;

  function openModal() { errorEl.classList.add('hidden'); form.reset(); modal.classList.remove('hidden'); }
  function closeModal() { modal.classList.add('hidden'); }

  document.getElementById('openAddUser')!.addEventListener('click', openModal);
  document.getElementById('closeAddUser')!.addEventListener('click', closeModal);
  document.getElementById('cancelAddUser')!.addEventListener('click', closeModal);
  document.getElementById('addUserOverlay')!.addEventListener('click', closeModal);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');
    submitBtn.textContent = 'Creating...';
    submitBtn.setAttribute('disabled', 'true');

    const body = {
      name: (document.getElementById('newUserName') as HTMLInputElement).value.trim(),
      email: (document.getElementById('newUserEmail') as HTMLInputElement).value.trim(),
      password: (document.getElementById('newUserPassword') as HTMLInputElement).value,
      role: (document.getElementById('newUserRole') as HTMLSelectElement).value,
      phone: (document.getElementById('newUserPhone') as HTMLInputElement).value.trim() || undefined,
    };

    const res = await fetch('/api/users', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });

    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      window.location.reload();
    } else {
      errorEl.textContent = data.error || 'Failed to create user';
      errorEl.classList.remove('hidden');
      submitBtn.textContent = 'Create User';
      submitBtn.removeAttribute('disabled');
    }
  });
</script>
