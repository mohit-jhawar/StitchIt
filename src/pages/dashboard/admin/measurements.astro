---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import db from '../../../lib/db';
import { formatDate } from '../../../lib/utils';

const user = Astro.locals.user;
if (!user || user.role !== 'ADMIN') return Astro.redirect('/dashboard');

const search = Astro.url.searchParams.get('search') || '';
const tailorFilter = Astro.url.searchParams.get('tailor') || '';

// Fetch all measurements with customer info and filter
const measurements = await db.measurement.findMany({
  orderBy: { createdAt: 'desc' },
  include: {
    customer: {
      select: { name: true, phone: true, userId: true },
    },
  },
  where: {
    ...(search ? {
      OR: [
        { customer: { name: { contains: search, mode: 'insensitive' } } },
        { name: { contains: search, mode: 'insensitive' } },
        { savedByName: { contains: search, mode: 'insensitive' } },
      ]
    } : {}),
    ...(tailorFilter ? { savedByRole: 'TAILOR', savedByName: { contains: tailorFilter, mode: 'insensitive' } } : {}),
  },
});

const tailors = await db.tailorProfile.findMany({ select: { name: true }, orderBy: { name: 'asc' } });

const totalMeasurements = measurements.length;
const byTailor = measurements.filter(m => m.savedByRole === 'TAILOR').length;
const bySelf = measurements.filter(m => m.savedByRole === 'CUSTOMER').length;
const byAdmin = measurements.filter(m => m.savedByRole === 'ADMIN').length;
---

<DashboardLayout title="All Measurements - StitchIt" pageTitle="Measurements">
  <div class="space-y-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Customer Measurements</h1>
      <p class="text-gray-500 text-sm mt-1">Full view of all customer measurement profiles across the shop.</p>
    </div>

    <!-- Summary stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { label: 'Total Records', value: totalMeasurements, color: 'bg-indigo-50 text-indigo-600', border: 'border-indigo-200', icon: '📏' },
        { label: 'Tailor Created', value: byTailor, color: 'bg-purple-50 text-purple-600', border: 'border-purple-200', icon: '✂️' },
        { label: 'Self-entered', value: bySelf, color: 'bg-green-50 text-green-600', border: 'border-green-200', icon: '👤' },
        { label: 'By Admin', value: byAdmin, color: 'bg-blue-50 text-blue-600', border: 'border-blue-200', icon: '🛡️' },
      ].map((s) => (
        <div class={`bg-white rounded-xl border ${s.border} p-4 flex items-center gap-3`}>
          <div class={`w-10 h-10 ${s.color} rounded-xl flex items-center justify-center text-xl flex-shrink-0`}>{s.icon}</div>
          <div>
            <p class="text-xs text-gray-500">{s.label}</p>
            <p class="text-xl font-bold text-gray-900">{s.value}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Filters -->
    <!-- Filters -->
    <form method="GET" class="flex flex-col sm:flex-row gap-2">
      <div class="relative flex-1">
        <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input name="search" value={search} type="text" placeholder="Search customer or measurement..." 
          class="w-full pl-8 pr-3 py-1.5 border border-gray-300 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500"/>
      </div>
      <select name="tailor" class="px-2 py-1.5 border border-gray-300 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
        <option value="">All Sources</option>
        {tailors.map(t => (
          <option value={t.name} selected={tailorFilter === t.name}>{t.name} (Tailor)</option>
        ))}
      </select>
      <button type="submit" class="px-3 py-1.5 bg-indigo-600 text-white rounded-lg text-xs font-medium hover:bg-indigo-700 transition-colors">Filter</button>
      {(search || tailorFilter) && <a href="/dashboard/admin/measurements" class="px-3 py-1.5 bg-gray-100 text-gray-700 rounded-lg text-xs font-medium hover:bg-gray-200 transition-colors text-center">Clear</a>}
    </form>

    <!-- Measurements table -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      {measurements.length === 0 ? (
        <div class="p-12 text-center text-gray-400">
          <p class="text-4xl mb-2">📏</p>
          <p class="font-medium">No measurements found</p>
          {(search || tailorFilter) && <p class="text-sm mt-1">Try adjusting your filters</p>}
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="text-left px-4 py-2 font-medium text-gray-500 text-xs">Customer</th>
                <th class="text-left px-4 py-2 font-medium text-gray-500 text-xs">Profile Name</th>
                <th class="text-center px-4 py-2 font-medium text-gray-500 text-xs">Chest</th>
                <th class="text-center px-4 py-2 font-medium text-gray-500 text-xs">Waist</th>
                <th class="text-center px-4 py-2 font-medium text-gray-500 text-xs">Hip</th>
                <th class="text-center px-4 py-2 font-medium text-gray-500 text-xs">Shoulder</th>
                <th class="text-center px-4 py-2 font-medium text-gray-500 text-xs">Sleeve</th>
                <th class="text-left px-4 py-2 font-medium text-gray-500 text-xs">Saved By</th>
                <th class="text-left px-4 py-2 font-medium text-gray-500 text-xs text-right">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {measurements.map((m) => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-2">
                    <p class="font-medium text-gray-900 text-xs">{m.customer.name}</p>
                    {m.customer.phone && <p class="text-[10px] text-gray-400">{m.customer.phone}</p>}
                  </td>
                  <td class="px-4 py-2">
                    <p class="font-medium text-indigo-700 text-xs">{m.name}</p>
                    {m.notes && <p class="text-[10px] text-gray-400 mt-0.5 italic truncate max-w-[140px]">{m.notes}</p>}
                  </td>
                  <td class="px-4 py-2 text-center text-gray-700 text-xs">{m.chest ?? <span class="text-gray-300">—</span>}</td>
                  <td class="px-4 py-2 text-center text-gray-700 text-xs">{m.waist ?? <span class="text-gray-300">—</span>}</td>
                  <td class="px-4 py-2 text-center text-gray-700 text-xs">{m.hip ?? <span class="text-gray-300">—</span>}</td>
                  <td class="px-4 py-2 text-center text-gray-700 text-xs">{m.shoulder ?? <span class="text-gray-300">—</span>}</td>
                  <td class="px-4 py-2 text-center text-gray-700 text-xs">{m.sleeve ?? <span class="text-gray-300">—</span>}</td>
                  <td class="px-4 py-2">
                    {m.savedByName ? (
                      <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium ${
                        m.savedByRole === 'TAILOR' ? 'bg-purple-50 text-purple-700' :
                        m.savedByRole === 'ADMIN' ? 'bg-indigo-50 text-indigo-700' :
                        'bg-green-50 text-green-700'
                      }`}>
                        {m.savedByRole === 'TAILOR' ? '✂️' : m.savedByRole === 'ADMIN' ? '🛡️' : '👤'}
                        {m.savedByName}
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-green-50 text-green-700">👤 Self</span>
                    )}
                  </td>
                  <td class="px-4 py-2 text-gray-500 text-[10px] text-right">{formatDate(m.createdAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</DashboardLayout>
