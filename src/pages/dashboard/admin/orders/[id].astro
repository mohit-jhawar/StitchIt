---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import OrderDetail from '../../../../components/orders/OrderDetail';

const user = Astro.locals.user;
if (!user || user.role !== 'ADMIN') return Astro.redirect('/dashboard');

const { id } = Astro.params;
if (!id) return Astro.redirect('/dashboard/admin/orders');
---

<DashboardLayout title="Order Detail - StitchIt" pageTitle="Order Detail">
  <div class="space-y-6">
    <a href="/dashboard/admin/orders" class="text-sm text-gray-500 hover:text-indigo-600 transition-colors flex items-center gap-1">
      ← Back to Orders
    </a>
    <OrderDetail orderId={id} role="ADMIN" client:load />
  </div>
</DashboardLayout>
