---
import Layout from '../layouts/Layout.astro';
import { OtpForm } from '../components/auth/OtpForm';

const email = Astro.url.searchParams.get('email') || '';
const from = Astro.url.searchParams.get('from') || 'register';

if (!email) {
  return Astro.redirect(from === 'login' ? '/login' : '/register');
}
---

<Layout title="Verify Your Email — StitchShop">
  <div class="otp-page">

    <!-- Animated gradient orbs -->
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <!-- Floating dots -->
    <div class="dots-grid" aria-hidden="true">
      {Array.from({ length: 20 }).map((_, i) => (
        <span class="dot" style={`--i:${i}`}></span>
      ))}
    </div>

    <!-- Card -->
    <div class="otp-card">
      <OtpForm client:load email={email} from={from} />
    </div>

  </div>
</Layout>
