# Server Settings
PORT=4321
SITE_URL=http://localhost:4321
NODE_ENV=development

# Database Settings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stitchit?schema=public"

# Authentication
JWT_SECRET="your_jwt_secret_here"

# Email Integration (Brevo SMTP API)
BREVO_API="your_brevo_api_key_here"
BREVO_SENDER_EMAIL="your_brevo_verified_sender_email_here"
BREVO_SENDER_NAME="StitchIt Boutique"
ADMIN_NOTIFICATION_EMAIL="your_admin_notification_email_here"

# Cloud Media Uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name_here"
CLOUDINARY_API_KEY="your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"
